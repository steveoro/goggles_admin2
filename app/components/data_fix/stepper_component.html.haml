%ul.nav.nav-tabs.data-fix-stepper{ data: { data_fix_stepper: summary&.stage } }
  - steps.each do |step|
    %li.nav-item
      - if step[:number] == active_step
        .nav-link.active.d-flex.align-items-center.gap-2{ aria: { current: 'page' } }
          %span= label_for(step)
          = verdict_badge(verdict_for(step))
          = link_to(step_path(step, rescan: 1), class: 'btn btn-link btn-sm p-0 ms-1', title: t('data_fix.stepper.rescan'),
                                                data: { turbo_confirm: rescan_confirm(step) }) do
            %i.fa-solid.fa-rotate.text-warning{ 'aria-hidden': 'true' }
            %span.visually-hidden= t('data_fix.stepper.rescan')
      - else
        = link_to(step_path(step), class: 'nav-link d-flex align-items-center gap-2') do
          %span= label_for(step)
          = verdict_badge(verdict_for(step))

- if source_changed?
  .alert.alert-danger.d-flex.flex-wrap.align-items-center.gap-2.mt-2.mb-0#data-fix-source-changed{ role: 'alert' }
    %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
    %span.flex-grow-1= t('data_fix.stepper.source_changed', phases: source_changed_phases)
    = button_to(t('data_fix.stepper.discard_edits'), data_fix_discard_phase_edits_path,
                method: :post, params: { file_path: }, class: 'btn btn-sm btn-danger', form_class: 'd-inline',
                data: { turbo_confirm: t('data_fix.stepper.discard_edits_confirm', phases: source_changed_phases) })
- elsif active_verdict&.stale?
  .alert.alert-info.d-flex.flex-wrap.align-items-center.gap-2.mt-2.mb-0#data-fix-step-stale{ role: 'status' }
    %i.fa-solid.fa-clock-rotate-left{ 'aria-hidden': 'true' }
    %span.flex-grow-1= stale_text(active_verdict)
    = link_to(t('data_fix.stepper.rebuild'), step_path(active_step_entry, rescan: 1), class: 'btn btn-sm btn-outline-primary',
                                                                                      data: { turbo_confirm: rescan_confirm(active_step_entry) })
- elsif active_verdict&.adopted
  .small.text-body-secondary.mt-1#data-fix-step-adopted
    %i.fa-solid.fa-lock{ 'aria-hidden': 'true' }
    = t('data_fix.stepper.adopted')
- elsif active_verdict&.edited
  .small.text-body-secondary.mt-1#data-fix-step-edited
    %i.fa-solid.fa-pen{ 'aria-hidden': 'true' }
    = t('data_fix.stepper.edited')
