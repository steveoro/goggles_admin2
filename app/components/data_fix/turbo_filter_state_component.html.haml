= form_tag(@target_url,
           method: :get,
           class: @form_class,
           data: { controller: 'data-fix-filter-state',
                   'data-fix-filter-state-q-min-length-value': @q_min_length,
                   'data-fix-filter-state-target': 'form' }) do
  - @hidden_params.each do |key, value|
    = hidden_field_tag key, value

  .d-flex.align-items-center.gap-1
    %label.form-label.mb-0{ for: "#{@dom_id_prefix}-q" }= @filter_label
    .input-group.input-group-sm
      = text_field_tag :q,
                       @q,
                       id: "#{@dom_id_prefix}-q",
                       class: 'form-control',
                       placeholder: @q_placeholder,
                       data: { action: 'input->data-fix-filter-state#handleQInput',
                               'data-fix-filter-state-target': 'q' }
      %button.btn.btn-outline-secondary{ type: 'submit', title: t('data_fix.filter.search'), 'aria-label': 'Search' }
        %i.fa.fa-search

  .d-flex.align-items-center.gap-1
    %label.form-label.mb-0.text-nowrap{ for: "#{@dom_id_prefix}-per-page" }= t('data_fix.filter.per_page')
    = select_tag @per_page_param_name,
                 options_for_select(@per_page_options, @per_page_value),
                 id: "#{@dom_id_prefix}-per-page",
                 class: 'form-select form-select-sm',
                 data: { action: 'change->data-fix-filter-state#handlePerPageChange',
                         'data-fix-filter-state-target': 'perPage' }

  .btn-group.btn-group-sm{ role: 'group', aria: { label: @filter_label } }
    - filter_states.each do |value, suffix, label|
      = radio_button_tag :filter_state,
                         value,
                         checked_filter_state?(value),
                         id: "#{@dom_id_prefix}-#{suffix}",
                         class: 'btn-check',
                         autocomplete: 'off',
                         data: { action: 'change->data-fix-filter-state#handleStateChange',
                                 'data-fix-filter-state-target': 'state' }
      %label.btn.btn-outline-secondary{ for: "#{@dom_id_prefix}-#{suffix}" }= label

  - if @review_help_text.present?
    %small.text-body-secondary= @review_help_text
