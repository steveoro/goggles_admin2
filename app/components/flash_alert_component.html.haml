.toast.border-0{ role: 'alert', 'aria-live' => 'assertive', 'aria-atomic' => 'true', class: alert_css_classes,
                 data: { controller: 'toast', toast_autohide_value: autohide?.to_s } }
  .d-flex
    .toast-body
      - if @title.present?
        %strong.d-block
          %i.fa{ class: alert_title_class, 'aria-hidden' => 'true' }
          = @title
      %span.flash-body= @body
    %button.btn-close.me-2.m-auto{ 'aria-label' => 'Close', 'data-bs-dismiss' => 'toast', type: 'button' }
