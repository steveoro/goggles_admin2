.modal.fade{ id: "#{@base_dom_id}-modal", 'aria-hidden' => 'true', role: 'dialog', tabindex: '-1',
             'aria-labelledby' => 'modal title' }
  .modal-dialog.modal-lg{ role: 'document' }
    = form_tag(url_for(only_path: true, controller: @controller_name, action: @form_action),
               id: "frm-#{@base_dom_id}", method: :post) do
      / pass-through the grid filtering parameters:
      = hidden_field_tag(@grid_name, params[@grid_name].to_json) if params && params[@grid_name]
      = hidden_field_tag('page', params[:page]) if params && params[:page]
      = hidden_field_tag('per_page', params[:per_page]) if params && params[:per_page]
      .modal-content
        .modal-header
          %h5.modal-title{ id: "#{@base_dom_id}-modal-title" }
            = I18n.t('datagrid.sql_create.modal_title')
          %button.close{ 'aria-label' => I18n.t('datagrid.sql_create.cancel_btn'), 'data-dismiss' => 'modal' }
            %span{ 'aria-hidden' => 'true' } &times;
        .modal-body{ id: "#{@base_dom_id}-modal-body" }
          .form-group.row
            = content_tag(:small, class: 'col-sm-3') do
              = label_tag("#{@base_dom_id}[season_id]", I18n.t('datagrid.sql_create.season_label'),
                          class: 'col-form-label')
            .col-sm-9
              = render(LegacyAutoCompleteComponent.new(base_dom_id: @base_dom_id, base_api_url: lookup_base_url,
                       detail_endpoint: 'season', base_name: 'season',
                       search_endpoint: 'seasons', search_column: 'description',
                       label_column: 'header_year', label2_column: 'edition',
                       jwt: @jwt, show_top_labels: true))
          .form-group.row
            = content_tag(:small, class: 'col-sm-3') do
              = label_tag("#{@base_dom_id}[team_id]", I18n.t('datagrid.sql_create.team_label'),
                          class: 'col-form-label')
            .col-sm-9
              = render(LegacyAutoCompleteComponent.new(base_dom_id: @base_dom_id, base_api_url: lookup_base_url,
                       detail_endpoint: 'team', base_name: 'team',
                       search_endpoint: 'teams', search_column: 'name',
                       label_column: 'editable_name', label2_column: 'city_name',
                       jwt: @jwt, show_top_labels: true))
          .form-group.row
            = content_tag(:small, class: 'col-sm-3') do
              = label_tag("#{@base_dom_id}[user_id]", I18n.t('datagrid.sql_create.user_label'),
                          class: 'col-form-label')
            .col-sm-9
              = render(LegacyAutoCompleteComponent.new(base_dom_id: @base_dom_id, base_api_url: lookup_base_url,
                       detail_endpoint: 'user', base_name: 'user',
                       search_endpoint: 'users', search_column: 'email',
                       label_column: 'description', label2_column: 'name',
                       jwt: @jwt, show_top_labels: true))

        .modal-footer
          %button.btn.btn-sm.btn-outline-secondary{ 'aria-label' => I18n.t('datagrid.sql_create.cancel_btn'),
                                                    'data-dismiss' => 'modal', type: 'button' }
            = I18n.t('datagrid.sql_create.cancel_btn')
          %button.btn.btn-sm.btn-outline-success{ id: "btn-#{@base_dom_id}-submit-generate", type: 'submit',
                'aria-label' => I18n.t('datagrid.sql_create.generate_btn'),
                data: { turbo_confirm: I18n.t('datagrid.sql_create.confirm_msg') } }
            = I18n.t('datagrid.sql_create.generate_btn')
