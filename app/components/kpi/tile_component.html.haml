= content_tag(wrapper_tag, **wrapper_options) do
  .card-body.py-2.px-3
    .small.text-body-secondary.text-uppercase.d-flex.align-items-center.gap-2
      %i.fa-solid.fa-fw{ class: @icon, 'aria-hidden' => 'true' }
      %span.kpi-label= @label
    - if value?
      .fs-3.fw-semibold.text-body-emphasis.kpi-value= formatted_value
      .small.text-body-secondary
        = as_of_text
        - if state_text
          %span.kpi-note{ class: state_css }= ['·', state_text].join(' ')
    - else
      .fs-5.fw-semibold.kpi-state{ class: state_css }= state_text
