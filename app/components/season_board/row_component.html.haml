%tr{ id: "season-board-row-#{row.fin_event_id || row.key.to_s.parameterize}",
     class: ('table-body-secondary' if row.state == :cancelled),
     data: { state: row.state, busy: row.busy?.to_s } }
  %td.text-nowrap
    = row.date_text
    %small.text-body-secondary= row.year
  %td
    - if row.url.present?
      = link_to(row.name, row.url, target: '_blank', rel: 'noopener')
    - else
      = row.name
    - if row.info.present?
      %br
      %small.text-body-secondary= row.info
  %td= row.place
  %td
    - if row.meeting_id
      %b= "##{row.meeting_id}"
      %small= meeting_text
      %br
      %span.badge.text-bg-secondary{ title: t('season_board.counts.mir_tooltip') }
        #{t('season_board.counts.mir')} #{row.mir_count}
      %span.badge.text-bg-secondary{ title: t('season_board.counts.mrr_tooltip') }
        #{t('season_board.counts.mrr')} #{row.mrr_count}
    - elsif row.calendar_id
      %small.text-body-secondary= "cal. ##{row.calendar_id}"
    - else
      %span.text-body-secondary -
  %td
    %span.badge{ class: state_css, title: state_tooltip }= state_label
    - shown_flags.each do |flag|
      %span.badge{ class: flag_css(flag), title: t("season_board.flag_tooltips.#{flag}"), data: { flag: flag } }
        = t("season_board.flags.#{flag}")
  %td
    - activity_items.each do |item|
      %div
        - if item[:css].start_with?('text-bg')
          %span.badge{ class: item[:css], title: item[:tooltip] }
            - if item[:spin]
              %i.fa-solid.fa-spin.fa-rotate{ 'aria-hidden' => 'true' }
            = item[:text]
        - else
          %small{ class: item[:css], title: item[:tooltip] }= item[:text]
  %td.text-nowrap
    - if action_disabled?
      %button.btn.btn-sm.btn-outline-secondary{ type: 'button', disabled: true, title: disabled_tooltip,
                                                data: { row_lock: row.locked? ? 'locked' : 'busy' } }
        = action_kind == :link ? t('season_board.actions.link') : action_label
    - elsif action_kind && missing_url?
      %button.btn.btn-sm.btn-outline-secondary{ type: 'button', disabled: true, title: t('season_board.actions.no_url') }
        = action_label
    - elsif action_kind && post_action?
      = form_with(url: post_action_path, method: :post, authenticity_token: false,
                  class: 'd-inline', data: { turbo_frame: '_top' }) do
        = hidden_field_tag(:fin_event_id, row.fin_event_id, id: nil)
        = hidden_field_tag(:authenticity_token, csrf_token, id: nil) if csrf_token
        %button.btn.btn-sm.btn-primary{ type: 'submit' }= action_label
    - elsif link_action?
      = link_to(action_label, link_action_path, class: 'btn btn-sm btn-primary', title: link_title, data: { turbo_frame: '_top' })
    - elsif action_kind == :link && orphans.empty?
      %small.text-body-secondary.season-board-no-link-candidates= t('season_board.actions.no_link_candidates')
    - elsif action_kind == :link
      = form_with(url: season_board_link_path, method: :post, authenticity_token: false,
                  class: 'd-flex flex-nowrap align-items-center gap-1', data: { turbo_frame: '_top' }) do
        = hidden_field_tag(:fin_event_id, row.fin_event_id, id: nil)
        = hidden_field_tag(:authenticity_token, csrf_token, id: nil) if csrf_token
        = select_tag(:calendar_id, options_for_select(orphans.map { |orphan| [orphan_label(orphan), orphan.id] }),
                     prompt: t('season_board.actions.link_select_prompt'), id: nil,
                     class: 'form-select form-select-sm me-1', style: 'min-width: 0', required: true)
        %button.btn.btn-sm.btn-primary.flex-shrink-0{ type: 'submit' }= t('season_board.actions.link')
    - if show_secondary_link? && !row.busy?
      %details.m-1
        %summary.small.text-body-secondary= t('season_board.actions.link_secondary')
        = form_with(url: season_board_link_path, method: :post, authenticity_token: false,
                    class: 'd-flex flex-nowrap align-items-center gap-1 mt-1', data: { turbo_frame: '_top' }) do
          = hidden_field_tag(:fin_event_id, row.fin_event_id, id: nil)
          = hidden_field_tag(:authenticity_token, csrf_token, id: nil) if csrf_token
          = select_tag(:calendar_id, options_for_select(orphans.map { |orphan| [orphan_label(orphan), orphan.id] }),
                       prompt: t('season_board.actions.link_select_prompt'), id: nil,
                       class: 'form-select form-select-sm me-1', style: 'min-width: 0', required: true)
          %button.btn.btn-sm.btn-outline-secondary.flex-shrink-0{ type: 'submit' }= t('season_board.actions.link')
    - if secondary_prepare? || hold_toggle?
      .d-flex.flex-wrap.align-items-center.gap-2.mt-1.season-board-pipeline-actions
        - if secondary_prepare?
          = form_with(url: season_board_prepare_path, method: :post, authenticity_token: false,
                      class: 'd-inline', data: { turbo_frame: '_top' }) do
            = hidden_field_tag(:fin_event_id, row.fin_event_id, id: nil)
            = hidden_field_tag(:authenticity_token, csrf_token, id: nil) if csrf_token
            %button.btn.btn-sm.btn-outline-secondary{ type: 'submit', title: t('pipeline_automation.row.prepare_tooltip'),
                                                      data: { pipeline_action: 'prepare' } }
              = t('pipeline_automation.row.prepare')
        - if hold_toggle?
          = form_with(url: season_board_hold_path, method: :post, authenticity_token: false,
                      class: 'd-inline', data: { turbo_frame: '_top' }) do
            = hidden_field_tag(:fin_event_id, row.fin_event_id, id: nil)
            = hidden_field_tag(:hold, held? ? 0 : 1, id: nil)
            = hidden_field_tag(:authenticity_token, csrf_token, id: nil) if csrf_token
            %button.btn.btn-sm.btn-link.p-0{ type: 'submit', data: { pipeline_action: held? ? 'release' : 'hold' },
                                             title: t(held? ? 'pipeline_automation.row.release_tooltip' : 'pipeline_automation.row.hold_tooltip') }
              = t(held? ? 'pipeline_automation.row.release' : 'pipeline_automation.row.hold')
