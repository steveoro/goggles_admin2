.toast.border-0.sources-crawl-toast{ toast_attributes }
  .d-flex
    .toast-body
      %strong.d-block
        %i.fa-solid{ class: icon, 'aria-hidden' => 'true' }
        = title
      %span.d-block.small= @message
      = link_to(link_label, @link_path, class: "#{light_text? ? 'link-light' : 'link-dark'} fw-semibold small") if @link_path.present?
    %button.btn-close.me-2.m-auto{ class: ('btn-close-white' if light_text?), type: 'button',
                                   'aria-label' => t('sources.crawl.toast.close'), 'data-bs-dismiss' => 'toast' }
