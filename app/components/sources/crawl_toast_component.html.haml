.toast.border-0.sources-crawl-toast{ toast_attributes }
  .d-flex
    .toast-body
      %strong.d-block
        %i.fa-solid{ class: done? ? 'fa-spider' : 'fa-triangle-exclamation', 'aria-hidden' => 'true' }
        = title
      %span.d-block.small= @message
      = link_to(link_label, @link_path, class: 'link-light fw-semibold small') if @link_path.present?
    %button.btn-close.btn-close-white.me-2.m-auto{ 'aria-label' => t('sources.crawl.toast.close'), 'data-bs-dismiss' => 'toast', type: 'button' }
