= render(Grid::PageComponent.new(title: t('dashboard.categories.title'), model: GogglesDb::CategoryType, grid: @grid,
                                 domain: api_grid_domain)) do |page|
  - page.with_toolbar_extra do
    .btn-group#clone-btn
      %a.btn.btn-sm.btn-primary#clone-expand{ 'aria-controls' => 'clone-categories-panel', 'aria-expanded' => 'false',
                                              href: '#clone-categories-panel', role: 'button',
                                              title: t('datagrid.clone_form.btn_tooltip'),
                                              data: { bs_toggle: 'collapse' } }
        %i.fa.fa-clone
  .collapse.mb-3#clone-categories-panel
    .card
      .card-header= t('datagrid.clone_form.btn_tooltip')
      .card-body
        = form_tag(api_categories_clone_path, method: :post) do
          .row.g-3.align-items-end
            .col-auto
              = label_tag('from_season', t('datagrid.clone_form.source_season'), class: 'form-label')
              = number_field_tag('from_season', nil, min: 0,
                                 required: true, autofocus: true, class: 'form-control')
            .col-auto
              = label_tag('to_season', t('datagrid.clone_form.target_season'), class: 'form-label')
              = number_field_tag('to_season', nil, min: 0,
                                 required: true, autofocus: true, class: 'form-control')
            .col-auto
              = submit_tag(t('datagrid.clone_form.clone_button'), id: 'btn-clone', class: 'btn btn-primary',
                           'aria-label': t('datagrid.clone_form.clone_button'), type: 'submit',
                           data: { turbo_confirm: t('datagrid.clone_form.confirm_msg') })
