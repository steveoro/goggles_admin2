%p.py-2= t('issues.existing_request_count', total: existing_issues.count)
%p
  %code active: #{active ? '✅' : '🚫'}

%section#form-bottom-toolbar
  .row.my-4
    .col.text-center
      = form_tag(api_issue_fix_path(id: issue_id), id: 'frm-type5', method: :post) do
        .bg-light-green.p-3.shadow-box
          .form-check.d-inline-block.text-start
            = check_box_tag(:send_email, '1', false, class: 'form-check-input')
            = label_tag(:send_email, t('issues.send_email_label'), class: 'form-check-label')
          .py-3
            - btn_enabled = processable && !active
            = submit_tag(t('issues.grid.buttons.fix_label'), id: 'btn-solve',
                         class: "btn btn-sm btn-success #{btn_enabled ? '' : 'disabled'}", disabled: !btn_enabled,
                         data: { turbo_confirm: t('issues.ask_confirmation') })
