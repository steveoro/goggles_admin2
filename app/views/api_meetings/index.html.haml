= render(Grid::PageComponent.new(title: t('dashboard.meetings.title'), model: GogglesDb::Meeting, grid: @grid,
                                 domain: api_grid_domain, toolbar: { create: false, destroy: false })) do |page|
  - page.with_toolbar_extra do
    .btn-group#csv-0mirs-btn
      = link_to(api_meetings_no_mirs_path(@grid_filter_params),
                data: { bs_toggle: 'tooltip', bs_title: t('datagrid.csv_export.btn_localhost_0mirs_tooltip') },
                class: 'btn btn-sm btn-outline-primary', role: 'button') do
        = t('datagrid.csv_export.btn_localhost_0mirs_label')
        %i.fa.fa-download
      -# (the data health report lists the meetings without results per season, relay-only meetings excluded)
      - health_season_id = @grid_filter_params.to_h['season_id'].presence
      = link_to(health_season_id ? health_season_path(health_season_id, anchor: 'health-group-meetings') : health_path,
                class: 'btn btn-sm btn-outline-secondary', role: 'button', id: 'btn-health-report',
                data: { bs_toggle: 'tooltip', bs_title: t('health.meetings_grid_link_tooltip') }) do
        %i.fa-solid.fa-heart-pulse{ 'aria-hidden' => 'true' }
        = t('health.meetings_grid_link')
