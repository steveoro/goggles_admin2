= render(Grid::PageComponent.new(title: t('dashboard.team_managers.title'), model: GogglesDb::ManagedAffiliation,
                                 grid: @grid, domain: api_grid_domain)) do |page|
  - page.with_toolbar_extra do
    .btn-group#sql-create-btn
      -# (a modal toggle can't also be a Bootstrap tooltip: the plain title gives the native hint)
      = link_to('#sql-create-modal', class: 'btn btn-sm btn-outline-success', role: 'button',
                title: t('datagrid.sql_create.btn_tooltip'), data: { bs_toggle: 'modal' }) do
        %i.fa.fa-plus
        = t('datagrid.sql_create.btn_label')
= render(Grid::SqlCreateModalComponent.new(controller_name: controller_name, jwt: current_user.jwt))
