- provide(:title, t('.title'))
= render(Shell::PageHeaderComponent.new(title: t('.title'), subtitle: t('.description')))

%section.my-2#select-team
  = form_with(url: best_in_5y_results_path, method: :get, local: true,
              data: { controller: 'form-utils', action: 'submit->form-utils#disableSubmit',
                      turbo: false }) do |f|
    .row.g-2.align-items-end.my-3
      .col-md-5.col-lg-4
        = render(ComboBox::AutocompleteTeamComponent.new(default_row: @team, required: true, jwt: current_user&.jwt))
      .col-md-4.col-lg-3
        .btn-group.w-100{ role: 'group' }
          = f.submit t('datagrid.form.search'), class: 'btn btn-primary'
          - disabled_class = @results_by_swimmer.blank? ? 'disabled' : ''
          = link_to(best_in_5y_results_path(format: :csv, team_id: @team&.id),
                    class: "btn btn-outline-secondary #{disabled_class}",
                    disabled: @results_by_swimmer.blank?, 'data-turbo': false) do
            %i.fa.fa-file-text-o
            CSV
          = link_to(best_in_5y_results_path(format: :xlsx, team_id: @team&.id),
                    class: "btn btn-outline-secondary #{disabled_class}",
                    disabled: @results_by_swimmer.blank?, 'data-turbo': false) do
            %i.fa.fa-file-excel-o
            XLSX

= render(partial: 'best_results_list',
         locals: { results_by_swimmer: @results_by_swimmer, team: @team })
