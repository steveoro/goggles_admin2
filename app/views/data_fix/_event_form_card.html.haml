:ruby
  issue_codes = Array(local_assigns[:issue_codes])
  card_data = { controller: 'event-card', event_card_index_value: event_index,
                event_card_existing_events_value: Array(existing_meeting_events).to_json,
                issue: data_fix_issue_marker(issue_codes) }
.card.mb-2.data-fix-card{ class: "#{card_bg} #{border_color} #{border_width}", id: "event-card-#{event_index}", data: card_data }
  .card-header.d-flex.justify-content-between.align-items-center.gap-2{ id: "event-header-#{event_index}", role: 'button',
                                                                        aria: { expanded: is_new_event.to_s, controls: "event-panel-#{event_index}" },
                                                                        data: { bs_toggle: 'collapse', bs_target: "#event-panel-#{event_index}" } }
    .d-flex.flex-wrap.align-items-center.gap-2
      - if has_match
        %i.fa.fa-check-circle.text-success{ title: t('data_fix.wizard.badges.matched') }
      - else
        %i.fa.fa-plus-circle.text-warning{ title: t('data_fix.wizard.badges.unmatched') }
      %strong= event_key
      - if has_match
        %small.badge.text-bg-success= t('data_fix.wizard.badges.id', id: event_id)
      - else
        %small.badge.text-bg-primary= t('data_fix.wizard.badges.new')
      - if issue_codes.any?
        %small.badge.text-bg-warning.data-fix-issue-badge{ title: data_fix_issue_title(issue_codes) }
          %i.fa-solid.fa-hand-point-right{ 'aria-hidden': 'true' }
          = t('data_fix.wizard.card_issue')
    .d-flex.align-items-center
      -# Delete button (only for events without DB ID)
      - if event_id.blank?
        = form_tag(data_fix_delete_event_path, method: :delete, class: 'd-inline',
                   data: { turbo_confirm: t('data_fix.wizard.confirm.delete_event', key: event_key) }) do
          = hidden_field_tag :file_path, file_path
          = hidden_field_tag :session_index, session_index
          = hidden_field_tag :event_index, local_event_index
          %button.btn.btn-sm.btn-danger{ type: 'submit', 'aria-label' => t('data_fix.wizard.buttons.delete'),
                                         data: { action: 'click->event-card#stop' } }
            %i.fa.fa-trash{ 'aria-hidden': 'true' }

  .collapse{ class: ('show' if is_new_event), id: "event-panel-#{event_index}", 'aria-labelledby': "event-header-#{event_index}",
             data: { issue_panel: true } }
    .card-body.border-bottom
      = form_tag(update_phase4_event_path, method: :patch) do
        = hidden_field_tag :file_path, file_path
        = hidden_field_tag :session_index, session_index
        = hidden_field_tag :event_index, local_event_index

        .container-fluid
          -# Row 0: Session Binding (use session_order as value, not array index)
          .row.mb-3
            .col-12
              %label.form-label Session Binding
              - session_options = sessions.map.with_index do |s, i|
                - s_order = s['session_order'] || (i + 1)
                - label = "Session #{s_order}"
                - label += " - #{s['description']}" if s['description'].present?
                - label += " (#{s['scheduled_date']})" if s['scheduled_date'].present?
                - [label, s_order]
              = select_tag :target_session_order, options_for_select(session_options, session_order), class: 'form-select'
              %small.form-text.text-body-secondary Change to move event to a different session

          -# Row 1: Event Order & Begin Time
          .row
            .col-6
              %label.form-label Event Order
              = number_field_tag('event[event_order]', event['event_order'],
                                 class: 'form-control', min: 1,
                                 id: "event_#{event_index}_order")
            .col-6
              %label.form-label Begin Time
              = time_field_tag('event[begin_time]', event['begin_time'],
                               class: 'form-control', step: 900,
                               id: "event_#{event_index}_begin_time")

          -# Row 2: Meeting Event ID
          .row
            .col
              %label.form-label Event ID
              - if existing_meeting_events.present?
                - event_options = existing_meeting_events.map do |me|
                  - label = "#{me['event_type_label']} (S#{me['session_order']}, E#{me['event_order']}, ID: #{me['id']})"
                  - [label, me['id']]
                = select_tag('event[meeting_event_id]',
                             options_for_select([['-- New Event --', '']] + event_options, event['id']),
                             class: 'form-select',
                             id: "meeting_event_#{event_index}_id",
                             data: { action: 'change->event-card#populateFromExisting' })
                %small.form-text.text-body-secondary Select to populate from existing
              - else
                = number_field_tag('event[meeting_event_id]', event['id'],
                                   class: 'form-control', placeholder: 'Leave blank for new')
                %small.form-text.text-body-secondary No meeting events available

          -# Row 3: Event Type (AutoComplete) & Heat Type
          .row.mt-2
            .col
              %label.form-label Event Type
              = render(LegacyAutoCompleteComponent.new(base_dom_id: "event",
                                                 payload: event_types_payload, base_name: 'event_type',
                                                 search_column: 'label_column', label_column: 'long_label',
                                                 default_value: event['event_type_id']))
          .row.mt-1
            .col-auto
              %label.form-label Heat Type
              = select_tag('event[heat_type_id]',
                           options_from_collection_for_select(heat_types, 'id', 'long_label', event['heat_type_id']),
                           class: 'form-select',
                           id: "event_#{event_index}_heat_type_id")
            .col-auto
              .form-check.mt-4
                - autofilled_val = is_new_event ? false : event.fetch('autofilled', true)
                = check_box_tag('event[autofilled]', '1', autofilled_val, class: 'form-check-input', id: "event_#{event_index}_autofilled")
                %label.form-check-label{ for: "event_#{event_index}_autofilled" } Autofilled
                %small.form-text.text-body-secondary Uncheck if manually edited

          -# Legacy fields (auto-populated from event_type/heat_type)
          .row.mt-2
            .col-4
              %small.form-text.text-body-secondary Distance
              = number_field_tag('event[distance]', event['distance'],
                                 readonly: true, class: 'form-control form-control-sm', min: 25,
                                 id: "event_#{event_index}_distance")
            .col-4
              %small.form-text.text-body-secondary Stroke
              = text_field_tag('event[stroke]', event['stroke'],
                               readonly: true, class: 'form-control form-control-sm',
                               id: "event_#{event_index}_stroke")
            .col-4
              %small.form-text.text-body-secondary Heat Type
              = text_field_tag('event[heat_type]', event['heat_type'],
                               readonly: true, class: 'form-control form-control-sm',
                               id: "event_#{event_index}_heat_type_code")

          -# Submit button
          .row.mt-3
            .col-12
              = submit_tag(t('data_fix.wizard.buttons.save_event'), class: 'btn btn-primary')
