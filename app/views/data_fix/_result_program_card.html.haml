-# frozen_string_literal: true

:ruby
  # Displays a collapsible card for a MeetingProgram group with expandable result rows
  #
  # == Params:
  # - program_key: String, e.g., "1-200RA-M75-F"
  # - results: Array of DataImportMeetingIndividualResult
  # - swimmers_by_id: Hash of Swimmer by ID (for matched swimmers)
  # - swimmers_by_key: Hash of swimmer data by key (for unmatched swimmers from phase 3)
  # - teams_by_id: Hash of Team by ID (for matched teams)
  # - teams_by_key: Hash of Team data by key (for unmatched teams from phase 2)
  # - team_key_by_swimmer_key: Hash mapping swimmer_key => team_key (from phase 3 badges)
  # - laps_by_parent_key: Hash of DataImportLap arrays by parent_import_key
  # - card_index: Integer, for unique IDs
  # - deletion_candidates: Array<Hash>, existing MIRs absent from the imported set
  # - program_card_index_by_key: Hash, program key => card index for merge target links
  # - issue: Boolean, the program is in the issue list (DataFix::IssueDetector): next/previous issue marker
  deletion_candidates ||= []
  issue = local_assigns[:issue] == true
  program_card_index_by_key ||= {}
  parts = program_key.split('-')
  session_order = parts[0]
  event_code = parts[1]
  category = parts[2]
  gender = parts[3]
  # Split results: non-DSQ first (sorted by rank), then DSQ (natural order)
  non_dsq_results = results.reject(&:disqualified?).sort_by(&:rank)
  dsq_results = results.select(&:disqualified?)
  sorted_results = non_dsq_results + dsq_results
  program_id = results.first&.meeting_program_id || deletion_candidates.first&.fetch('meeting_program_id', nil)
  has_match = program_id.present?
  border_width = 'border-2'

  # Check if any result has missing swimmer data
  has_issues = sorted_results.any? do |mir|
    if mir.swimmer_id
      swimmer = swimmers_by_id[mir.swimmer_id]
      swimmer && (swimmer.gender_type_id.nil? || swimmer.year_of_birth.nil?)
    else
      mir.swimmer_key && swimmer_has_missing_data?(mir.swimmer_key, swimmers_by_key: swimmers_by_key).values.any?
    end
  end

  has_issues ||= gender.to_s.strip.blank?
  gender_display = gender.presence || '?'

  border_color = if has_issues
                   'border-danger'
                 elsif deletion_candidates.present?
                   'border-danger'
                 elsif has_match
                   'border-success'
                 else
                   'border-warning'
                 end

.card.mb-2.data-fix-card{ class: "#{border_color} #{border_width}", id: "program-card-#{card_index}",
                          data: { has_issues: has_issues, controller: 'verify-result', issue: ('result_issues' if issue) } }
  .card-header.d-flex.justify-content-between.align-items-center.gap-2{ id: "program-header-#{card_index}", role: 'button',
                                                                        aria: { expanded: 'true', controls: "program-panel-#{card_index}" },
                                                                        data: { bs_toggle: 'collapse', bs_target: "#program-panel-#{card_index}" } }
    .d-flex.flex-wrap.align-items-center.gap-2
      %span
        - if deletion_candidates.present?
          %i.fa.fa-trash.text-danger{ title: 'Existing results marked for deletion' }
        - elsif has_match
          %i.fa.fa-check-circle.text-success{ title: 'Matched MeetingProgram' }
        - else
          %i.fa.fa-plus-circle.text-warning{ title: 'New MeetingProgram' }
      %strong
        = "#{event_code} • #{category} • #{gender_display}"
      &nbsp;
      %small.ms-2.text-body-secondary
        Session #{session_order}
      - if has_match
        %small.ms-2.badge.text-bg-success
          ID: #{program_id}
      - else
        %small.ms-2.badge.text-bg-primary
          NEW
    .d-flex.align-items-center
      %span.badge.text-bg-info
        = "#{sorted_results.size} results"
      - if deletion_candidates.present?
        %span.badge.text-bg-danger.ms-1= "#{deletion_candidates.size} to delete"

  .collapse.show{ id: "program-panel-#{card_index}", 'aria-labelledby': "program-header-#{card_index}", data: { issue_panel: true } }
    .card-body.p-0.table-responsive
      %table.table.table-sm.table-hover.mb-0
        %thead.table-body-tertiary
          %tr
            %th.text-center{ style: 'width: 40px;' }
            %th.text-center{ style: 'width: 50px;' } Rank
            %th Swimmer
            %th Team
            %th.text-end Timing
            %th.text-center Status
        %tbody
          - sorted_results.each_with_index do |mir, idx|
            :ruby
              swimmer = swimmers_by_id[mir.swimmer_id]
              # Try to find team by ID first (matched teams)
              team = teams_by_id[mir.team_id]
              team_data = nil
              # If no team found by ID, look up by key using swimmer_key from import_key
              if team.nil? && teams_by_key.present? && team_key_by_swimmer_key.present?
                swimmer_key = mir.import_key.split('/')[1] # Extract swimmer_key from import_key
                team_key = team_key_by_swimmer_key[swimmer_key]
                team_data = teams_by_key[team_key] if team_key
              end
              # Fully matched = swimmer AND team both have DB IDs
              is_fully_matched = swimmer.present? && team.present?
              # Existing result = already has a matched DB ID (will not be inserted on commit)
              is_existing_result = mir.meeting_individual_result_id.to_i.positive?
              laps = laps_by_parent_key[mir.import_key] || []
              has_laps = laps.any?
              result_id = "result-#{card_index}-#{idx}"
            %tr{ id: "#{result_id}-row", class: is_existing_result ? '' : 'bg-light-yellow' }
              %td.text-center
                - if has_laps
                  -# (the chevron turns with the collapse state: .data-fix-laps-toggle in pages/_data_fix.scss)
                  %button.btn.btn-link.btn-sm.p-0.data-fix-laps-toggle.collapsed{ type: 'button', title: 'Laps',
                                                                                  aria: { expanded: 'false', controls: "#{result_id}-laps" },
                                                                                  data: { bs_toggle: 'collapse', bs_target: "##{result_id}-laps" } }
                    %i.fa.fa-chevron-right{ 'aria-hidden': 'true' }
                    %span.visually-hidden Laps
              %td.text-center
                - if mir.disqualified?
                  %span.text-body-secondary -
                - else
                  = mir.rank
              %td
                - if swimmer
                  = swimmer.complete_name
                  %small.text-body-secondary= "(#{swimmer.year_of_birth})"
                  - if swimmer.id
                    %small.text-success= swimmer.id
                - else
                  %code.text-body-secondary= mir.import_key.split('/')[1]
              %td
                - if team
                  = team.editable_name
                  %small.text-body-secondary= "(#{team.id})"
                - elsif team_data
                  = team_data['editable_name'] || team_data['name']
                  - if team_data['team_id']
                    %small.text-body-secondary= "(#{team_data['team_id']})"
                - else
                  %span.text-body-secondary N/A
              %td.text-end
                - if mir.disqualified?
                  %span.text-body-secondary —
                - else
                  %strong= mir.to_timing.to_s
              %td.text-center
                - if mir.disqualified?
                  %span.badge.text-bg-danger DSQ
                - elsif is_existing_result
                  %i.fa.fa-check-circle.text-success{ title: "Existing result (ID: #{mir.meeting_individual_result_id})" }
                - elsif is_fully_matched
                  %i.fa.fa-plus-circle.text-warning{ title: 'New result (will be created on commit)' }
                  - if mir.swimmer_id.to_i.positive? && mir.meeting_program_id.to_i.positive?
                    %button.btn.btn-outline-secondary.btn-sm.ms-1{ type: 'button', title: 'Verify for duplicates', data: { action: 'click->verify-result#verify', verify_result_import_key_param: mir.import_key, verify_result_result_type_param: 'individual', verify_result_target_panel_param: "##{result_id}-verify" } }
                      %i.fa.fa-search.me-1
                      Verify
                - else
                  %i.fa.fa-exclamation-circle.text-warning{ title: 'New result with unmatched swimmer or team' }
            -# Verification panel (expanded via AJAX)
            %tr.collapse{ id: "#{result_id}-verify" }
              %td{ colspan: 6 }
                .bg-body-tertiary.border.border-info.p-2
                  .text-center.text-body-secondary
                    %i.fa.fa-spinner.fa-spin
                    Checking for duplicates...
            - if has_laps
              %tr.collapse{ id: "#{result_id}-laps" }
                %td{ colspan: 6 }
                  .bg-body-tertiary.p-2
                    %table.table.table-sm.mb-0
                      %thead
                        %tr
                          %th.text-center Distance
                          %th.text-end Delta
                          %th.text-end From Start
                          %th.text-center Status
                      %tbody
                        - laps.each do |lap|
                          :ruby
                            # Delta timing (default columns)
                            delta_timing = Timing.new(
                              minutes: lap.minutes,
                              seconds: lap.seconds,
                              hundredths: lap.hundredths
                            )
                            # From-start timing (cumulative)
                            from_start_timing = Timing.new(
                              minutes: lap.minutes_from_start,
                              seconds: lap.seconds_from_start,
                              hundredths: lap.hundredths_from_start
                            )
                            # Matched lap ID (if present)
                            lap_match_id = lap.lap_id
                          %tr
                            %td.text-center
                              %strong= "#{lap.length_in_meters}m"
                            %td.text-end
                              = delta_timing.to_s
                            %td.text-end.text-body-secondary
                              = from_start_timing.to_s
                            %td.text-center
                              - if lap_match_id
                                %small.text-secondary
                                  ID: #{lap_match_id}
                              - else
                                %small.badge.text-bg-primary NEW
          - deletion_candidates.each do |candidate|
            :ruby
              selected = candidate['selected'] == true
              merge = selected && candidate['merge'] == true
              merge_available = candidate['merge_available'] == true
              merge_ambiguous = candidate['merge_ambiguous'] == true
              candidate_row_class = selected ? (merge ? 'bg-info text-white' : 'bg-danger text-white') : 'bg-body-tertiary text-body-secondary'
            %tr{ class: candidate_row_class, data: { candidate_id: candidate['id'] } }
              %td.text-end.align-middle
                .d-flex.flex-column.align-items-end.gap-1
                  %input.form-check-input{ type: 'checkbox', checked: selected, aria: { label: "Select MIR #{candidate['id']} for deletion" }, title: t('data_import.data_fix.individual_result_overwrite_zero_timing_help'), data: { action: 'change->data-fix-overwrite#toggle', data_fix_overwrite_target: 'candidate', candidate_id: candidate['id'], minutes: candidate['minutes'], seconds: candidate['seconds'], hundredths: candidate['hundredths'] } }
                  - if merge_available
                    %input.form-check-input{ type: 'checkbox', checked: merge, disabled: !selected, aria: { label: "Merge laps of MIR #{candidate['id']} into target result" }, title: t('data_import.data_fix.individual_result_overwrite_merge_label'), data: { action: 'change->data-fix-overwrite#toggleMerge', data_fix_overwrite_target: 'merge', candidate_id: candidate['id'] } }
              %td.text-center
                - if candidate['disqualified']
                  %span -
                - else
                  = candidate['rank']
              %td
                %strong= candidate['swimmer_name'].presence || "Swimmer #{candidate['swimmer_id']}"
                %small.ms-1= "(#{candidate['swimmer_year_of_birth']})" if candidate['swimmer_year_of_birth']
                %small.ms-1= "ID: #{candidate['swimmer_id']}"
              %td
                = candidate['team_name'].presence || "Team #{candidate['team_id']}"
                %small.ms-1= "(ID: #{candidate['team_id']})"
              %td.text-end
                %strong= candidate['timing']
                %small.d-block= "#{candidate['lap_count']} lap(s)"
              %td.text-center
                - if merge_available && merge
                  %span.badge.text-bg-light.text-info{ data: { data_fix_overwrite_status: 'merge' } }= t('data_import.data_fix.individual_result_overwrite_merged')
                - elsif selected
                  %span.badge.text-bg-light.text-danger{ data: { data_fix_overwrite_status: 'selected' } }= t('data_import.data_fix.individual_result_overwrite_selected')
                - else
                  %span.badge.text-bg-secondary{ data: { data_fix_overwrite_status: 'ignored' } }= t('data_import.data_fix.individual_result_overwrite_ignored')
                %small.d-block= t('data_import.data_fix.individual_result_overwrite_reason')
                - if merge_ambiguous
                  %small.d-block.text-warning= t('data_import.data_fix.individual_result_overwrite_merge_ambiguous')
                - elsif merge_available && selected
                  %small.d-block.text-info{ data: { data_fix_overwrite_target: 'mergeTarget' } }
                    = t('data_import.data_fix.individual_result_overwrite_merge_target', program_key: candidate['merge_target_program_key'])
                - elsif selected
                  %small.d-block.text-body-secondary= t('data_import.data_fix.individual_result_overwrite_no_merge_target')
            - if candidate['merge_target_import_key'].present?
              - target_parts = candidate['merge_target_program_key'].to_s.split('-')
              - target_card_index = program_card_index_by_key[candidate['merge_target_program_key']]
              - link_text_color = candidate_row_class.include?('text-white') ? 'text-white' : 'text-body'
              %tr{ class: candidate_row_class, data: { candidate_id: candidate['id'] } }
                %td
                %td
                %td{ colspan: 2 }
                  %span.badge.text-bg-light
                    = t('data_import.data_fix.merge_target_line_badge', mir_id: candidate['id'])
                  - if target_card_index
                    %a.ms-1{ href: "#program-card-#{target_card_index}",
                             title: t('data_import.data_fix.individual_result_overwrite_merge_target', program_key: candidate['merge_target_program_key']),
                             class: "#{link_text_color} text-decoration-underline" }
                      = t('data_import.data_fix.merge_target_line_arrow',
                          event_code: target_parts[1] || 'N/A',
                          category_code: target_parts[2] || 'N/A',
                          gender_code: target_parts[3] || 'N/A')
                  - else
                    %span.ms-1
                      = t('data_import.data_fix.merge_target_line_arrow',
                          event_code: target_parts[1] || 'N/A',
                          category_code: target_parts[2] || 'N/A',
                          gender_code: target_parts[3] || 'N/A')
                %td
                %td
