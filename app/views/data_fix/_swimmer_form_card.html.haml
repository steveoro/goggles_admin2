-#
  One Step 3 swimmer card (rendered by data_fix/_swimmer_card_frame, inside its key-based Turbo frame).
  Positional ids (swimmer-card-N, swimmer-header-N, swimmer-panel-N, swimmer_N_*, fuzzy_select_N) are kept for the
  anchors, the specs and the swimmer-card controller.
:ruby
  issue_codes = Array(local_assigns[:issue_codes])
  fuzzy_matches = swimmer_hash['fuzzy_matches'] || []
  selected_match = fuzzy_matches.find { |m| m['id'] == swimmer_id }
  xref_top = ((swimmer_hash.dig('team_cross_ref', 'candidates') || []).find { |c| c['id'] != swimmer_id } if similar_on_team)
  xref_team_id = xref_top&.dig('matching_team_id')
  xref_title = 'Similar swimmer detected but no alternative candidate - likely a false positive'
  xref_title = 'Similar swimmer on same team - please verify' if xref_top
  xref_title = "Similar swimmer on team ID #{xref_team_id} - please verify" if xref_team_id
  # (restored by swimmer-card#selectMatch when no fuzzy match is selected)
  baseline_data = { id: nil, complete_name: swimmer_hash['complete_name'], last_name: swimmer_hash['last_name'],
                    first_name: swimmer_hash['first_name'], year_of_birth: swimmer_hash['year_of_birth'],
                    gender_type_code: swimmer_hash['gender_type_code'] }
  keep_params = %i[swimmers_page swimmers_per_page q filter_state unmatched needs_review name_differs]
  card_data = { controller: 'swimmer-card', swimmer_card_index_value: swimmer_index,
                swimmer_card_baseline_value: baseline_data.to_json, issue: data_fix_issue_marker(issue_codes) }
.card.mb-2.data-fix-card{ class: "#{card_bg} #{border_color} #{border_width}", id: "swimmer-card-#{swimmer_index}", data: card_data }
  .card-header.d-flex.justify-content-between.align-items-center.gap-2{ id: "swimmer-header-#{swimmer_index}", role: 'button',
                                                                        aria: { expanded: 'false', controls: "swimmer-panel-#{swimmer_index}" },
                                                                        data: { bs_toggle: 'collapse', bs_target: "#swimmer-panel-#{swimmer_index}" } }
    .d-flex.flex-wrap.align-items-center.gap-2
      %i.fa{ class: icon_class, title: icon_title }
      %strong= swimmer_hash['complete_name']
      %small.fw-bold
        (#{swimmer_hash['year_of_birth']}, #{swimmer_hash['gender_type_code']})
        %i.fa.fa-key.text-warning.ms-1{ 'aria-hidden': 'true' }
        = swimmer_key
        - if swimmer_team_key.present?
          %i.fa.fa-users.text-info.ms-1{ title: 'Associated team key' }
          = swimmer_team_key
      - if has_badge_duplicates && badge_duplicate_summary.present?
        %small.text-body-secondary= badge_duplicate_summary
      - if has_match
        %small.badge{ class: "text-bg-#{selected_match&.[]('color_class').presence || 'success'}" }= t('data_fix.wizard.badges.id', id: swimmer_id)
        - if gender_guessed
          %small.badge.text-bg-warning{ title: 'Gender inferred from high-confidence fuzzy match - please verify' }
            %i.fa.fa-question-circle{ 'aria-hidden': 'true' }
            GENDER GUESSED
        - if similar_on_team
          %small.badge{ class: selected_match&.dig('percentage').to_f >= 100.0 ? 'text-bg-light' : 'text-bg-warning', title: xref_title }
            %i.fa.fa-exclamation-triangle{ 'aria-hidden': 'true' }
            - if xref_top
              SIMILAR ROW FOUND: ID #{xref_top['id']} (#{xref_top['complete_name']})
            - else
              SIMILAR NAME ON SAME TEAM
      - if has_badge_duplicates
        %small.badge.text-bg-danger{ title: 'Duplicate badges found for same swimmer+season on different teams - manual merge recommended' }
          %i.fa.fa-clone{ 'aria-hidden': 'true' }
          DUPLICATE BADGES
      - elsif has_missing_data
        %small.badge.text-bg-danger= t('data_fix.wizard.badges.missing_data')
        - if missing_name
          %small.badge.text-bg-danger No Name
        - if missing_yob
          %small.badge.text-bg-danger No YOB
        - if missing_gender
          %small.badge.text-bg-danger No Gender
      - elsif similar_on_team && !has_match
        %small.badge.text-bg-warning{ title: xref_title }
          %i.fa.fa-exclamation-triangle{ 'aria-hidden': 'true' }
          - if xref_top
            SIMILAR ROW FOUND: ID #{xref_top['id']} (#{xref_top['complete_name']})
          - else
            SIMILAR NAME ON SAME TEAM
      - elsif !swimmer_id
        -# (the NEW badge only for truly new swimmers: no matched/selected ID)
        %small.badge.text-bg-primary= t('data_fix.wizard.badges.new')
      - if swimmer_hash['confirmed'] == true
        %small.badge.text-bg-secondary.data-fix-confirmed-badge
          %i.fa-solid.fa-check{ 'aria-hidden': 'true' }
          = t('data_fix.wizard.badges.confirmed')
      - if issue_codes.any?
        %small.badge.text-bg-warning.data-fix-issue-badge{ title: data_fix_issue_title(issue_codes) }
          %i.fa-solid.fa-hand-point-right{ 'aria-hidden': 'true' }
          = t('data_fix.wizard.card_issue')
    .d-flex.align-items-center
      -# (full-page redirect: the delete form targets the page, not the card frame)
      = form_tag(data_fix_delete_swimmer_path, method: :delete, class: 'd-inline',
                 data: { turbo_frame: '_top', turbo_confirm: t('data_fix.wizard.confirm.delete_swimmer', name: swimmer_hash['complete_name']) }) do
        = hidden_field_tag :file_path, file_path
        = hidden_field_tag :swimmer_key, swimmer_key
        - keep_params.each do |key|
          = hidden_field_tag(key, params[key]) if params[key].present?
        %button.btn.btn-sm.btn-danger{ type: 'submit', 'aria-label' => t('data_fix.wizard.buttons.delete'),
                                       data: { action: 'click->swimmer-card#stop' } }
          %i.fa.fa-trash{ 'aria-hidden': 'true' }

  .collapse{ id: "swimmer-panel-#{swimmer_index}", 'aria-labelledby': "swimmer-header-#{swimmer_index}", data: { issue_panel: true } }
    .card-body.border-bottom
      -# (saved in place: update_phase3_swimmer answers a Turbo stream replacing this card, the stepper and the toasts)
      = form_tag(update_phase3_swimmer_path, method: :patch, id: "swimmer-form-#{swimmer_index}") do
        = hidden_field_tag :file_path, file_path
        = hidden_field_tag :swimmer_key, swimmer_key
        = hidden_field_tag :card_index, swimmer_index
        - keep_params.each do |key|
          = hidden_field_tag(key, params[key]) if params[key].present?

        -# Row 0: Fuzzy matches dropdown (quick selection)
        - if fuzzy_matches.present?
          .mb-2
            = label_tag("fuzzy_select_#{swimmer_index}", t('data_fix.wizard.swimmers.quick_match'), class: 'form-label')
            = select_tag("fuzzy_select_#{swimmer_index}",
                         options_for_select([['-- Select a match --', '']] + fuzzy_matches.map { |m| [m['display_label'], m['id']] }, swimmer_id),
                         class: 'form-select', id: "fuzzy_select_#{swimmer_index}",
                         data: { action: 'change->swimmer-card#selectMatch' })
            %small.form-text.text-body-secondary= t('data_fix.wizard.swimmers.quick_match_hint')

        -# Row 1: Swimmer AutoComplete + complete_name + hidden ID field
        .row.g-2
          .col-lg-5
            = hidden_field_tag('swimmer[id]', swimmer_id, id: "swimmer_#{swimmer_index}_id_field")
            = render(LegacyAutoCompleteComponent.new(show_top_labels: true,
                                                     base_dom_id: "swimmer[#{swimmer_index}]", base_api_url: api_url,
                                                     default_value: swimmer_id,
                                                     detail_endpoint: 'swimmer', base_name: 'swimmer', label_column: 'complete_name',
                                                     search_endpoint: 'swimmers', search_column: 'complete_name',
                                                     search2_dom_id: "swimmer_#{swimmer_index}_year_of_birth", search2_column: 'year_of_birth',
                                                     search3_dom_id: "swimmer_#{swimmer_index}_gender_type_code", search3_column: 'gender_type_code',
                                                     target3_dom_id: "swimmer_#{swimmer_index}_gender_type_code", target3_column: 'gender_code',
                                                     target4_dom_id: "swimmer_#{swimmer_index}_last_name", target4_column: 'last_name',
                                                     target5_dom_id: "swimmer_#{swimmer_index}_first_name", target5_column: 'first_name',
                                                     target6_dom_id: "swimmer_#{swimmer_index}_complete_name", target6_column: 'complete_name',
                                                     target7_dom_id: "swimmer_#{swimmer_index}_id_field", target7_column: 'id',
                                                     jwt: current_user.jwt))
            %small.form-text.text-body-secondary Clear search to unmatch swimmer
          .col-lg-7
            = label_tag("swimmer_#{swimmer_index}_complete_name", 'Complete Name', class: 'form-label')
            = text_field_tag('swimmer[complete_name]', swimmer_hash['complete_name'],
                             class: 'form-control', id: "swimmer_#{swimmer_index}_complete_name")
        -# Row 2: Last Name + First Name + Year of Birth + Gender
        .row.g-2.mt-1
          .col-md-4
            = label_tag("swimmer_#{swimmer_index}_last_name", 'Last Name', class: 'form-label')
            = text_field_tag('swimmer[last_name]', swimmer_hash['last_name'], class: 'form-control', id: "swimmer_#{swimmer_index}_last_name")
          .col-md-4
            = label_tag("swimmer_#{swimmer_index}_first_name", 'First Name', class: 'form-label')
            = text_field_tag('swimmer[first_name]', swimmer_hash['first_name'], class: 'form-control', id: "swimmer_#{swimmer_index}_first_name")
          .col-md-2
            = label_tag("swimmer_#{swimmer_index}_year_of_birth", 'Year of Birth', class: 'form-label')
            = number_field_tag('swimmer[year_of_birth]', swimmer_hash['year_of_birth'],
                               class: 'form-control', id: "swimmer_#{swimmer_index}_year_of_birth")
          .col-md-2
            = label_tag("swimmer_#{swimmer_index}_gender_type_code", 'Gender Type Code', class: 'form-label')
            = select_tag('swimmer[gender_type_code]', options_for_select([%w[M M], %w[F F]], swimmer_hash['gender_type_code']),
                         include_blank: true, class: 'form-select', id: "swimmer_#{swimmer_index}_gender_type_code")
        .mt-3
          = submit_tag(t('data_fix.wizard.buttons.save_swimmer'), class: 'btn btn-primary',
                                                                  data: { turbo_submits_with: t('data_fix.wizard.buttons.saving') })
