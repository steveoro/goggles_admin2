-#
  Persistent Phase 6 commit report (native Bootstrap 5, phase 09): reopenable by id; the status frame polls
  (live-frames, every 2 s) while the report is queued or running.
.container-fluid{ data: { controller: 'live-frames', live_frames_interval_value: 2000 } }
  = render(Shell::PageHeaderComponent.new(title: t('data_fix.commit_report.title'),
                                          subtitle: t('data_fix.commit_report.subtitle', source: File.basename(@report.source_path.to_s)))) do |header|
    - header.with_actions do
      = link_to(t('data_fix.commit_report.back_to_files'), sources_results_path, class: 'btn btn-sm btn-outline-secondary')
      = link_to(t('season_board.back_to_board'), season_board_path, class: 'btn btn-sm btn-outline-primary')

  = render(partial: 'data_fix/commit_reports/status', locals: { report: @report, polling: true })
