-# frozen_string_literal: true

= render(partial: 'data_fix_legacy/modal_progress')

.container-fluid{ data: { controller: 'collapse-all data-fix-overwrite', collapse_all_selector_value: '[id^="program-panel-"], [id^="relay-program-panel-"]',
                                      data_fix_overwrite_update_url_value: update_individual_result_overwrite_candidate_path,
                                      data_fix_overwrite_merge_url_value: update_individual_result_merge_candidate_path,
                                      data_fix_overwrite_bulk_url_value: bulk_update_individual_result_overwrite_path,
                                      data_fix_overwrite_file_path_value: @file_path,
                                      data_fix_overwrite_confirmation_value: I18n.t('data_import.data_fix.confirm_individual_result_overwrite', count: '%{count}'),
                                      data_fix_overwrite_selected_label_value: t('data_import.data_fix.individual_result_overwrite_selected'),
                                      data_fix_overwrite_ignored_label_value: t('data_import.data_fix.individual_result_overwrite_ignored'),
                                      data_fix_overwrite_merged_label_value: t('data_import.data_fix.individual_result_overwrite_merged'),
                                      data_fix_overwrite_update_failed_message_value: t('data_import.data_fix.individual_result_overwrite_update_failed') } }
  = render(partial: 'data_fix/v2_phase_header',
           locals: { title: 'Data-Fix V2 • Step 5: Results (Phase 5)',
                     active_step: 5,
                     file_path: @file_path,
                     retry_needed: @retry_needed })

  .d-flex.justify-content-between.my-2
    = link_to '< Back to file list', pull_result_files_path, class: 'btn btn-outline-secondary mr-2'
    - if @all_results.present? || @has_relay_results || @overwrite_candidates.present?
      %div
        = button_to commit_phase6_path(file_path: @file_path),
                                       method: :post, class: 'btn btn-success',
                                       disabled: @issue_count.to_i.positive?,
                                       params: { confirm_overwrite: '1' },
                                       data: { turbo_confirm: I18n.t('data_import.data_fix.btn_start_sql_batch_confirm'),
                                               turbo_method: :post },
                                       form: { data: { action: 'submit->data-fix-overwrite#confirmCommit' } } do
          %i.fa.fa-database
          = I18n.t('data_import.data_fix.btn_start_sql_batch')
    %div
      %button.btn.btn-outline-primary.ml-2{ type: 'button', data: { action: 'collapse-all#toggle', collapse_all_target: 'button' } }
        %i.fa.fa-compress
        Collapse All Results

  .card.mb-3.border-warning
    .card-body.py-2.d-flex.justify-content-between.align-items-center
      %div
        %strong= t('data_import.data_fix.individual_result_overwrite_label')
        %small.d-block.text-muted
          = t('data_import.data_fix.individual_result_overwrite_help')
        - if @overwrite_existing_results && @overwrite_candidates.present?
          %span.badge.badge-danger.mt-1= "#{@overwrite_candidates.size} deletion candidate(s)"
      = form_with url: toggle_individual_result_overwrite_path, method: :post, local: true, class: 'mb-0' do |form|
        = form.hidden_field :file_path, value: @file_path
        = form.hidden_field :enabled, value: (@overwrite_existing_results ? '0' : '1')
        = form.submit(@overwrite_existing_results ? t('data_import.data_fix.disable_individual_result_overwrite') : t('data_import.data_fix.enable_individual_result_overwrite'),
                      class: @overwrite_existing_results ? 'btn btn-outline-danger' : 'btn btn-warning')

  - if @overwrite_existing_results && @overwrite_candidates.present?
    .alert.alert-danger
      %strong= t('data_import.data_fix.individual_result_overwrite_summary', count: @overwrite_selected_count, merge_count: @overwrite_merge_count)
      %span.ml-1= t('data_import.data_fix.individual_result_overwrite_merge_hint')
      %small.d-block.mt-1= t('data_import.data_fix.individual_result_overwrite_zero_timing_help')

    .card.mb-3{ data: { data_fix_overwrite_target: 'toolbar' } }
      .card-body.py-2.d-flex.justify-content-between.align-items-center
        %span
          %strong= t('data_import.data_fix.individual_result_overwrite_active_count')
          = ": "
          %span{ data: { data_fix_overwrite_target: 'selectedCount' } }= @overwrite_selected_count
          = "/ "
          %span{ data: { overwrite_total_count: true } }= @overwrite_candidates.size
          = " #{t('data_import.data_fix.individual_result_overwrite_candidate_count')}"
          %span.ms-2.text-info{ data: { data_fix_overwrite_target: 'mergeCount' }, style: (@overwrite_merge_count.to_i.positive? ? '' : 'display: none;') }
            = t('data_import.data_fix.individual_result_overwrite_merge_count', count: @overwrite_merge_count)
        .btn-group.btn-group-sm
          %button.btn.btn-outline-danger{ type: 'button', data: { action: 'click->data-fix-overwrite#bulk', operation: 'select_all' } }= t('data_import.data_fix.individual_result_overwrite_select_all')
          %button.btn.btn-outline-secondary{ type: 'button', data: { action: 'click->data-fix-overwrite#bulk', operation: 'deselect_all' } }= t('data_import.data_fix.individual_result_overwrite_deselect_all')
          %button.btn.btn-outline-warning{ type: 'button', data: { action: 'click->data-fix-overwrite#bulk', operation: 'deselect_zero_timing' } }= t('data_import.data_fix.individual_result_overwrite_deselect_zero_timing')

  - basename = File.basename(@file_path).split('.json').first
  = render(partial: 'data_fix/phase_metadata', locals: { phase_number: 5, metadata: @phase5_meta,
                                                         extra_info: basename })

  - if @populate_stats
    .alert.alert-info.mb-3
      %strong Populated:
      = @populate_stats[:mir_created]
      individual results,
      = @populate_stats[:laps_created]
      laps
      - if @populate_stats[:relay_results_created]&.positive?
        %span.ms-2
          |
          = @populate_stats[:relay_results_created]
          relay results,
          = @populate_stats[:relay_swimmers_created]
          swimmers,
          = @populate_stats[:relay_laps_created]
          relay laps
      - if @populate_stats[:errors].any?
        %span.text-danger.ms-2
          (#{@populate_stats[:errors].size} errors)

  - if @total_programs_count.to_i.zero?
    .alert.alert-warning
      %p No results loaded from phase5 JSON yet.
      %p
        = link_to 'Populate DB Tables', review_results_path(file_path: @file_path, phase5_v2: 1, populate_db: 1), class: 'btn btn-primary'
  - else
    -# Issue Summary Banner (always shown)
    - if @issue_count.to_i.positive?
      .alert.alert-warning.d-flex.justify-content-between.align-items-center
        %div
          %i.fa.fa-exclamation-triangle.me-2
          %strong= "#{@issue_count} program(s) with issues detected"
          %span.text-muted.ms-2 (missing program gender, unresolved required links excluding NEW meeting programs, or swimmer/team/badge/affiliation inconsistencies)
        %div
          - if @filter_active
            = link_to review_results_path(file_path: @file_path, phase5_v2: 1, filter_issues: '0'), class: 'btn btn-sm btn-outline-secondary' do
              %i.fa.fa-times
              Show All Programs
          - else
            = link_to review_results_path(file_path: @file_path, phase5_v2: 1, filter_issues: '1'), class: 'btn btn-sm btn-warning' do
              %i.fa.fa-filter
              Show Only Issues
    - else
      .alert.alert-success
        %i.fa.fa-check-circle.me-2
        %strong All results are valid!
        No unresolved required links detected.

    -# New Results Summary Banner
    - if @new_result_count.to_i.positive?
      .alert.alert-info.d-flex.justify-content-between.align-items-center
        %div
          %i.fa.fa-plus-circle.me-2
          %strong= "#{@new_result_count} new result(s) will be created on commit"
          - if @unmatched_parent_count.to_i.positive? && @unmatched_parent_count != @new_result_count
            %span.ms-2.text-muted= "(#{@unmatched_parent_count} unmatched parent rows)"
        %div.d-flex.gap-2
          - if @filter_new_active
            = link_to review_results_path(file_path: @file_path, phase5_v2: 1), class: 'btn btn-sm btn-outline-secondary' do
              %i.fa.fa-times
              Show All
          - elsif !@filter_unmatched_active
            = link_to review_results_path(file_path: @file_path, phase5_v2: 1, filter_new: '1'), class: 'btn btn-sm btn-info' do
              %i.fa.fa-filter
              Show New Only
          - if @filter_unmatched_active
            = link_to review_results_path(file_path: @file_path, phase5_v2: 1), class: 'btn btn-sm btn-outline-secondary' do
              %i.fa.fa-times
              Show All
          - elsif !@filter_new_active
            = link_to review_results_path(file_path: @file_path, phase5_v2: 1, filter_unmatched: '1'), class: 'btn btn-sm btn-warning' do
              %i.fa.fa-plus-circle
              Show Only (+) Rows

    -# Pagination and Filter Controls (similar to teams/swimmers pages)
    .card.mb-3
      .card-body.py-2
        .d-flex.justify-content-between.align-items-center
          %div
            %strong Page:
            = @current_page
            = "/"
            = @total_pages
            &nbsp;•&nbsp;
            %strong Programs:
            = @phase5_programs.size
            = "/"
            = @filter_active ? @issue_count : @total_programs_count
            - if @filter_active
              %span.badge.bg-warning.ms-2 Filtered: Issues
            - if @filter_new_active
              %span.badge.bg-info.ms-2 Filtered: New only
            - if @filter_unmatched_active
              %span.badge.bg-warning.ms-2 Filtered: (+) Rows only

          -# Pagination links (first, prev, next, last)
          - if @total_pages && @total_pages > 1
            .flex-grow-1.text-center
              - pagination_base_params = request.query_parameters.except(:page)
              = link_to '«', review_results_path(pagination_base_params.merge(page: 1)),
                        class: "btn btn-sm btn-outline-primary me-1 #{'disabled' if @current_page == 1}",
                        title: 'First'
              = link_to '‹', review_results_path(pagination_base_params.merge(page: [@current_page - 1, 1].max)),
                        class: "btn btn-sm btn-outline-primary me-1 #{'disabled' if @current_page == 1}",
                        title: 'Previous'
              %span.mx-2= "#{@current_page} / #{@total_pages}"
              = link_to '›', review_results_path(pagination_base_params.merge(page: [@current_page + 1, @total_pages].min)),
                        class: "btn btn-sm btn-outline-primary me-1 #{'disabled' if @current_page == @total_pages}",
                        title: 'Next'
              = link_to '»', review_results_path(pagination_base_params.merge(page: @total_pages)),
                        class: "btn btn-sm btn-outline-primary #{'disabled' if @current_page == @total_pages}",
                        title: 'Last'

      -# Separate individual and relay programs
      - individual_programs = @phase5_programs.reject { |p| p['relay'] }
      - relay_programs = @phase5_programs.select { |p| p['relay'] }

      -# Individual Results Section
      - if individual_programs.any?
        .mb-3
          %strong Total individual programs:
          = individual_programs.size
          %span.text-muted.ml-2
            (#{individual_programs.sum { |p| p['result_count']&.to_i || 0 }} results)

        -# Build a lookup from program key to card index for merge target links
        :ruby
          program_card_index_by_key = individual_programs.each_with_index.each_with_object({}) do |(program, card_idx), hash|
            hash["#{program['session_order']}-#{program['event_code']}-#{program['category_code']}-#{program['gender_code'] || ''}"] = card_idx
          end

        -# Responsive grid: 2 columns on large displays
        .row
          - individual_programs.each_with_index do |program, idx|
            :ruby
              # Build program_key for compatibility with partials
              program_key = "#{program['session_order']}-#{program['event_code']}-#{program['category_code']}-#{program['gender_code'] || ''}"
              # Query temp tables for this program's results
              results = GogglesDb::DataImportMeetingIndividualResult.where(
                phase_file_path: @file_path
              ).where(
                "import_key LIKE ?", "#{program_key}/%"
              ).order(:rank)
              deletion_candidates = @overwrite_candidates_by_program_key.fetch(program_key, [])
            .col-12.col-lg-6
              = render(partial: 'data_fix/result_program_card',
                       locals: { program_key: program_key, results: results, deletion_candidates: deletion_candidates,
                                 swimmers_by_id: @swimmers_by_id,
                                 swimmers_by_key: @swimmers_by_key, teams_by_id: @teams_by_id, teams_by_key: @teams_by_key,
                                 team_key_by_swimmer_key: @team_key_by_swimmer_key,
                                 laps_by_parent_key: @laps_by_parent_key, card_index: idx,
                                 program_card_index_by_key: program_card_index_by_key })

      -# Relay Results Section
      - if relay_programs.any?
        .mt-5
          %h3.mb-3
            %i.fa.fa-users.me-2
            Relay Results

          .mb-3
            %strong Total relay programs:
            = relay_programs.size
            %span.text-muted.ml-2
              (#{relay_programs.sum { |p| p['result_count']&.to_i || 0 }} results)

          -# Responsive grid: 2 columns on large displays
          .row
            - relay_programs.each_with_index do |program, idx|
              :ruby
                # Build program_key for compatibility with partials
                program_key = "#{program['session_order']}-#{program['event_code']}-#{program['category_code']}-#{program['gender_code']}"
                # Query temp tables for this program's relay results
                relay_results = GogglesDb::DataImportMeetingRelayResult.where(
                  phase_file_path: @file_path
                ).where(
                  "import_key LIKE ?", "#{program_key}/%"
                ).order(:rank)
              .col-12.col-lg-6
                = render(partial: 'data_fix/relay_program_card',
                         locals: { program_key: program_key, relay_results: relay_results,
                                   swimmers_by_id: @swimmers_by_id, swimmers_by_key: @swimmers_by_key,
                                   teams_by_id: @teams_by_id, teams_by_key: @teams_by_key,
                                   relay_swimmers_by_parent_key: @relay_swimmers_by_parent_key,
                                   relay_laps_by_parent_key: @relay_laps_by_parent_key,
                                   relay_swimmer_names: @relay_swimmer_names,
                                   card_index: idx })
  .mb-4 &nbsp;

-# Verify/confirm logic handled by verify-result Stimulus controller (verify_result_controller.js)