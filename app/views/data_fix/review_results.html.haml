-# frozen_string_literal: true

= render(partial: 'goggles/modal_progress')

:ruby
  basename = File.basename(@file_path).split('.json').first
  results_params = { file_path: @file_path, phase5_v2: 1 }
  overwrite_data = { controller: 'collapse-all data-fix-overwrite',
                     collapse_all_selector_value: '[id^="program-panel-"], [id^="relay-program-panel-"]',
                     collapse_all_collapse_label_value: t('data_fix.wizard.buttons.collapse_all'),
                     collapse_all_expand_label_value: t('data_fix.wizard.buttons.expand_all'),
                     data_fix_overwrite_update_url_value: update_individual_result_overwrite_candidate_path,
                     data_fix_overwrite_merge_url_value: update_individual_result_merge_candidate_path,
                     data_fix_overwrite_bulk_url_value: bulk_update_individual_result_overwrite_path,
                     data_fix_overwrite_file_path_value: @file_path,
                     data_fix_overwrite_confirmation_value: I18n.t('data_import.data_fix.confirm_individual_result_overwrite', count: '%{count}'),
                     data_fix_overwrite_selected_label_value: t('data_import.data_fix.individual_result_overwrite_selected'),
                     data_fix_overwrite_ignored_label_value: t('data_import.data_fix.individual_result_overwrite_ignored'),
                     data_fix_overwrite_merged_label_value: t('data_import.data_fix.individual_result_overwrite_merged'),
                     data_fix_overwrite_update_failed_message_value: t('data_import.data_fix.individual_result_overwrite_update_failed') }
.container-fluid{ data: overwrite_data }
  = render(Shell::PageHeaderComponent.new(title: t('data_fix.wizard.title', number: 5, name: t('data_fix.steps.results')),
                                          subtitle: basename)) do |header|
    - header.with_actions do
      = link_to(pull_result_files_path, class: 'btn btn-sm btn-outline-secondary') do
        %i.fa-solid.fa-arrow-left{ 'aria-hidden': 'true' }
        = t('data_fix.wizard.back_to_files')
      -# (phase 09) what the commit will do, a fresh preflight and the same Commit POST as the button below
      = link_to(data_fix_commit_summary_path(file_path: @file_path), class: 'btn btn-sm btn-outline-success', id: 'btn-commit-summary-link') do
        %i.fa-solid.fa-list-check{ 'aria-hidden': 'true' }
        = t('data_fix.commit_summary.link')
      - if @result_free
        -# Structure-only commit: enabled only when meeting + sessions are valid
        = button_to(commit_phase6_path(file_path: @file_path), method: :post, class: 'btn btn-sm btn-success',
                                                               disabled: !@structure_report&.valid?,
                                                               data: { turbo_confirm: I18n.t('data_import.data_fix.btn_commit_structure_confirm'),
                                                                       turbo_method: :post }) do
          %i.fa.fa-database{ 'aria-hidden': 'true' }
          = I18n.t('data_import.data_fix.btn_commit_structure')
      - elsif @all_results.present? || @has_relay_results || @overwrite_candidates.present?
        = button_to(commit_phase6_path(file_path: @file_path), method: :post, class: 'btn btn-sm btn-success',
                                                               disabled: @issue_count.to_i.positive?,
                                                               params: { confirm_overwrite: '1' },
                                                               data: { turbo_confirm: I18n.t('data_import.data_fix.btn_start_sql_batch_confirm'),
                                                                       turbo_method: :post },
                                                               form: { data: { action: 'submit->data-fix-overwrite#confirmCommit' } }) do
          %i.fa.fa-database{ 'aria-hidden': 'true' }
          = I18n.t('data_import.data_fix.btn_start_sql_batch')

  = render(data_fix_stepper(5))
  = render(DataFix::IssueNavComponent.new(nav: @issue_nav)) do |nav|
    - nav.with_toggle do
      - unless @result_free || @total_programs_count.to_i.zero?
        -# (phase 12) "Verify all": every new result with exactly one identical existing result takes its ids (never commits)
        = button_to(data_fix_verify_all_results_path, method: :post, params: request.query_parameters.slice('filter_issues', 'filter_new', 'filter_unmatched', 'page').merge(file_path: @file_path),
                    form_class: 'd-inline', class: 'btn btn-sm btn-outline-primary', id: 'btn-data-fix-verify-all',
                    title: t('data_fix.verify_all.title'),
                    data: { turbo_confirm: t('data_fix.verify_all.confirm'), turbo_submits_with: t('data_fix.verify_all.busy') }) do
          %i.fa-solid.fa-wand-magic-sparkles{ 'aria-hidden': 'true' }
          = t('data_fix.verify_all.button')
      %button.btn.btn-sm.btn-outline-secondary{ type: 'button', data: { action: 'collapse-all#toggle', collapse_all_target: 'button' } }
        %i.fa.fa-compress{ 'aria-hidden': 'true' }
        = t('data_fix.wizard.buttons.collapse_all')

  .card.mb-3.border-warning
    .card-body.py-2.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
      %div
        %strong= t('data_import.data_fix.individual_result_overwrite_label')
        %small.d-block.text-body-secondary
          = t('data_import.data_fix.individual_result_overwrite_help')
        - if @overwrite_existing_results && @overwrite_candidates.present?
          %span.badge.text-bg-danger.mt-1= t('data_fix.wizard.results.deletion_candidates', count: @overwrite_candidates.size)
      = form_with url: toggle_individual_result_overwrite_path, method: :post, local: true, class: 'mb-0' do |form|
        = form.hidden_field :file_path, value: @file_path
        = form.hidden_field :enabled, value: (@overwrite_existing_results ? '0' : '1')
        = form.submit(@overwrite_existing_results ? t('data_import.data_fix.disable_individual_result_overwrite') : t('data_import.data_fix.enable_individual_result_overwrite'),
                      class: @overwrite_existing_results ? 'btn btn-outline-danger' : 'btn btn-warning')

  - if @overwrite_existing_results && @overwrite_candidates.present?
    .alert.alert-danger
      %strong= t('data_import.data_fix.individual_result_overwrite_summary', count: @overwrite_selected_count, merge_count: @overwrite_merge_count)
      %span.ms-1= t('data_import.data_fix.individual_result_overwrite_merge_hint')
      %small.d-block.mt-1= t('data_import.data_fix.individual_result_overwrite_zero_timing_help')

    .card.mb-3{ data: { data_fix_overwrite_target: 'toolbar' } }
      .card-body.py-2.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
        %span
          %strong= t('data_import.data_fix.individual_result_overwrite_active_count')
          = ": "
          %span{ data: { data_fix_overwrite_target: 'selectedCount' } }= @overwrite_selected_count
          = "/ "
          %span{ data: { overwrite_total_count: true } }= @overwrite_candidates.size
          = " #{t('data_import.data_fix.individual_result_overwrite_candidate_count')}"
          %span.ms-2.text-info{ data: { data_fix_overwrite_target: 'mergeCount' }, style: (@overwrite_merge_count.to_i.positive? ? '' : 'display: none;') }
            = t('data_import.data_fix.individual_result_overwrite_merge_count', count: @overwrite_merge_count)
        .btn-group.btn-group-sm
          %button.btn.btn-outline-danger{ type: 'button', data: { action: 'click->data-fix-overwrite#bulk', operation: 'select_all' } }= t('data_import.data_fix.individual_result_overwrite_select_all')
          %button.btn.btn-outline-secondary{ type: 'button', data: { action: 'click->data-fix-overwrite#bulk', operation: 'deselect_all' } }= t('data_import.data_fix.individual_result_overwrite_deselect_all')
          %button.btn.btn-outline-warning{ type: 'button', data: { action: 'click->data-fix-overwrite#bulk', operation: 'deselect_zero_timing' } }= t('data_import.data_fix.individual_result_overwrite_deselect_zero_timing')

  = render(partial: 'data_fix/phase_metadata', locals: { phase_number: 5, metadata: @phase5_meta, extra_info: basename })

  - if @populate_stats
    .alert.alert-info.my-3
      %strong Populated:
      = @populate_stats[:mir_created]
      individual results,
      = @populate_stats[:laps_created]
      laps
      - if @populate_stats[:relay_results_created]&.positive?
        %span.ms-2
          |
          = @populate_stats[:relay_results_created]
          relay results,
          = @populate_stats[:relay_swimmers_created]
          swimmers,
          = @populate_stats[:relay_laps_created]
          relay laps
      - if @populate_stats[:errors].any?
        %span.text-danger.ms-2
          (#{@populate_stats[:errors].size} errors)

  - if @result_free
    .alert.alert-info.mt-2
      %i.fa.fa-info-circle.me-2{ 'aria-hidden': 'true' }
      %strong= t('data_import.data_fix.structure_only_title')
      %span.ms-1= t('data_import.data_fix.structure_only_hint')
    - if @structure_errors.present?
      .alert.alert-danger
        %strong= t('data_import.data_fix.structure_invalid_title')
        %ul.mb-1
          - @structure_errors.each do |error_message|
            %li= error_message
        %small= t('data_import.data_fix.structure_invalid_hint')
  - elsif @total_programs_count.to_i.zero?
    .alert.alert-warning.mt-2
      %p= t('data_fix.wizard.results.populate_hint')
      %p.mb-0
        = link_to(t('data_fix.wizard.buttons.populate'), review_results_path(results_params.merge(populate_db: 1)), class: 'btn btn-primary')
  - else
    -# Issue Summary Banner (always shown)
    - if @issue_count.to_i.positive?
      .alert.alert-warning.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mt-2
        %div
          %i.fa.fa-exclamation-triangle.me-2{ 'aria-hidden': 'true' }
          %strong= t('data_fix.wizard.results.issues_found', count: @issue_count)
          %span.text-body-secondary.ms-2= t('data_fix.wizard.results.issues_help')
        %div
          - if @filter_active
            = link_to(review_results_path(results_params.merge(filter_issues: '0')), class: 'btn btn-sm btn-outline-secondary') do
              %i.fa.fa-times{ 'aria-hidden': 'true' }
              = t('data_fix.wizard.buttons.show_all_programs')
          - else
            = link_to(review_results_path(results_params.merge(filter_issues: '1')), class: 'btn btn-sm btn-warning') do
              %i.fa.fa-filter{ 'aria-hidden': 'true' }
              = t('data_fix.wizard.buttons.show_only_issues')
    - else
      .alert.alert-success.mt-2
        %i.fa.fa-check-circle.me-2{ 'aria-hidden': 'true' }
        %strong= t('data_fix.wizard.results.all_valid')
        = t('data_fix.wizard.results.all_valid_hint')

    -# New Results Summary Banner
    - if @new_result_count.to_i.positive?
      .alert.alert-info.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
        %div
          %i.fa.fa-plus-circle.me-2{ 'aria-hidden': 'true' }
          %strong= t('data_fix.wizard.results.new_results', count: @new_result_count)
          - if @unmatched_parent_count.to_i.positive? && @unmatched_parent_count != @new_result_count
            %span.ms-2.text-body-secondary= t('data_fix.wizard.results.unmatched_parents', count: @unmatched_parent_count)
        .d-flex.gap-2
          - issues_param = @filter_active ? '1' : '0'
          - if @filter_new_active
            = link_to(review_results_path(results_params.merge(filter_issues: issues_param)), class: 'btn btn-sm btn-outline-secondary') do
              %i.fa.fa-times{ 'aria-hidden': 'true' }
              = t('data_fix.wizard.buttons.show_all')
          - elsif !@filter_unmatched_active
            = link_to(review_results_path(results_params.merge(filter_new: '1', filter_issues: issues_param)), class: 'btn btn-sm btn-info') do
              %i.fa.fa-filter{ 'aria-hidden': 'true' }
              = t('data_fix.wizard.buttons.show_new_only')
          - if @filter_unmatched_active
            = link_to(review_results_path(results_params.merge(filter_issues: issues_param)), class: 'btn btn-sm btn-outline-secondary') do
              %i.fa.fa-times{ 'aria-hidden': 'true' }
              = t('data_fix.wizard.buttons.show_all')
          - elsif !@filter_new_active
            = link_to(review_results_path(results_params.merge(filter_unmatched: '1', filter_issues: issues_param)), class: 'btn btn-sm btn-warning') do
              %i.fa.fa-plus-circle{ 'aria-hidden': 'true' }
              = t('data_fix.wizard.buttons.show_unmatched_only')

    -# Pagination and filter info
    .card.mb-3
      .card-body.py-2.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
        %div
          = t('data_fix.wizard.results.programs_info', page: @current_page, pages: @total_pages, shown: @phase5_programs.size,
                                                       count: @filter_active ? @issue_count : @total_programs_count)
          - if @filter_active
            %span.badge.text-bg-warning.ms-2= t('data_fix.wizard.results.filtered_issues')
          - if @filter_new_active
            %span.badge.text-bg-info.ms-2= t('data_fix.wizard.results.filtered_new')
          - if @filter_unmatched_active
            %span.badge.text-bg-warning.ms-2= t('data_fix.wizard.results.filtered_unmatched')

        -# Pagination links (first, prev, next, last)
        - if @total_pages && @total_pages > 1
          - pagination_base_params = request.query_parameters.except(:page)
          %nav.d-flex.align-items-center.gap-1{ aria: { label: 'Pages' } }
            = link_to('«', review_results_path(pagination_base_params.merge(page: 1)),
                      class: "btn btn-sm btn-outline-primary #{'disabled' if @current_page == 1}", title: 'First')
            = link_to('‹', review_results_path(pagination_base_params.merge(page: [@current_page - 1, 1].max)),
                      class: "btn btn-sm btn-outline-primary #{'disabled' if @current_page == 1}", title: 'Previous')
            %span.mx-2= "#{@current_page} / #{@total_pages}"
            = link_to('›', review_results_path(pagination_base_params.merge(page: [@current_page + 1, @total_pages].min)),
                      class: "btn btn-sm btn-outline-primary #{'disabled' if @current_page == @total_pages}", title: 'Next')
            = link_to('»', review_results_path(pagination_base_params.merge(page: @total_pages)),
                      class: "btn btn-sm btn-outline-primary #{'disabled' if @current_page == @total_pages}", title: 'Last')

    -# Separate individual and relay programs
    - individual_programs = @phase5_programs.reject { |p| p['relay'] }
    - relay_programs = @phase5_programs.select { |p| p['relay'] }

    -# Individual Results Section
    - if individual_programs.any?
      .mb-3
        = t('data_fix.wizard.results.individual_total', count: individual_programs.size,
                                                        results: individual_programs.sum { |p| p['result_count']&.to_i || 0 })
      :ruby
        # Program key => card index, for the merge target links
        program_card_index_by_key = individual_programs.each_with_index.each_with_object({}) do |(program, card_idx), hash|
          hash["#{program['session_order']}-#{program['event_code']}-#{program['category_code']}-#{program['gender_code'] || ''}"] = card_idx
        end

      -# Responsive grid: 2 columns on large displays
      .row.g-2
        - individual_programs.each_with_index do |program, idx|
          :ruby
            program_key = "#{program['session_order']}-#{program['event_code']}-#{program['category_code']}-#{program['gender_code'] || ''}"
            # Program results from the staging rows bucketed in the controller
            results = (@mirs_by_program[program_key] || []).sort_by { |row| row.rank.to_i }
            deletion_candidates = @overwrite_candidates_by_program_key.fetch(program_key, [])
          .col-12.col-lg-6
            = render(partial: 'data_fix/result_program_card',
                     locals: { program_key:, results:, deletion_candidates:, swimmers_by_id: @swimmers_by_id,
                               swimmers_by_key: @swimmers_by_key, teams_by_id: @teams_by_id, teams_by_key: @teams_by_key,
                               team_key_by_swimmer_key: @team_key_by_swimmer_key,
                               laps_by_parent_key: @laps_by_parent_key, card_index: idx,
                               program_card_index_by_key:, issue: @issue_program_keys.include?(program_key) })

    -# Relay Results Section
    - if relay_programs.any?
      .mt-5
        %h3.h4.mb-3
          %i.fa.fa-users.me-2{ 'aria-hidden': 'true' }
          = t('data_fix.wizard.results.relay_title')
        .mb-3
          = t('data_fix.wizard.results.relay_total', count: relay_programs.size,
                                                     results: relay_programs.sum { |p| p['result_count']&.to_i || 0 })
        -# Responsive grid: 2 columns on large displays
        .row.g-2
          - relay_programs.each_with_index do |program, idx|
            :ruby
              program_key = "#{program['session_order']}-#{program['event_code']}-#{program['category_code']}-#{program['gender_code']}"
              # Program relay results from the staging rows bucketed in the controller
              relay_results = (@mrrs_by_program[program_key] || []).sort_by { |row| row.rank.to_i }
            .col-12.col-lg-6
              = render(partial: 'data_fix/relay_program_card',
                       locals: { program_key:, relay_results:,
                                 swimmers_by_id: @swimmers_by_id, swimmers_by_key: @swimmers_by_key,
                                 teams_by_id: @teams_by_id, teams_by_key: @teams_by_key,
                                 relay_swimmers_by_parent_key: @relay_swimmers_by_parent_key,
                                 relay_laps_by_parent_key: @relay_laps_by_parent_key,
                                 relay_swimmer_names: @relay_swimmer_names,
                                 card_index: idx, issue: @issue_program_keys.include?(program_key) })
  .mb-4

-# Verify/confirm logic handled by the verify-result Stimulus controller (verify_result_controller.js)
