-# frozen_string_literal: true

= render(partial: 'goggles/modal_progress')

-# Phase 3 Swimmers view with collapsible cards + AutoComplete + fuzzy matching
- page_params = { filter_state: @filter_state, q: @q, swimmers_per_page: @per_page, file_path: @file_path, phase3_v2: 1 }
.container-fluid
  = render(Shell::PageHeaderComponent.new(title: t('data_fix.wizard.title', number: 3, name: t('data_fix.steps.swimmers')),
                                          subtitle: File.basename(@file_path).split('.json').first)) do |header|
    - header.with_actions do
      = link_to(pull_result_files_path, class: 'btn btn-sm btn-outline-secondary') do
        %i.fa-solid.fa-arrow-left{ 'aria-hidden': 'true' }
        = t('data_fix.wizard.back_to_files')
      = link_to(review_events_path(request.query_parameters.merge(phase4_v2: 1)), class: 'btn btn-sm btn-primary') do
        = t('data_fix.wizard.proceed', number: 4, name: t('data_fix.steps.events'))
        %i.fa-solid.fa-arrow-right{ 'aria-hidden': 'true' }

  = render(data_fix_stepper(3))
  = render(DataFix::IssueNavComponent.new(nav: @issue_nav))

  = render(partial: 'data_fix/phase_metadata', locals: { phase_number: 3, metadata: @phase3_meta,
                                                         extra_info: File.basename(@file_path).split('.json').first })
  - if @relay_enrichment_summary.present?
    = render(partial: 'data_fix/relay_enrichment_panel',
             locals: { summary: @relay_enrichment_summary,
                       auxiliary_files: @auxiliary_phase3_files,
                       selected_auxiliary: @selected_auxiliary_phase3_files,
                       show_new: @show_new_relay_swimmers, file_path: @file_path })

  -# Search and filter controls
  .card.my-2
    .card-header
      = render(DataFix::TurboFilterStateComponent.new(target_url: review_swimmers_path,
                                                      hidden_params: { file_path: @file_path, phase3_v2: 1 },
                                                      per_page_param_name: :swimmers_per_page,
                                                      per_page_value: @per_page, filter_state: @filter_state, q: @q,
                                                      q_min_length: DataFix::BaseController::TURBO_FILTER_MIN_QUERY_LENGTH,
                                                      q_placeholder: t('data_fix.wizard.swimmers.search_placeholder'),
                                                      review_help_text: t('data_fix.wizard.swimmers.review_help')))
    .card-body.py-2.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
      %span.small= t('data_fix.wizard.page_info', page: @page, pages: @total_pages, range: @row_range, count: @total_count)
      - if @items.present?
        .flex-grow-1
          = render(PageLinksForArrayComponent.new(data: @items, total_count: @total_count, page: @page, per_page: @per_page,
                                                  param_name: :swimmers_page, extra_params: page_params))
      = form_tag(data_fix_add_swimmer_path, method: :post, class: 'd-inline', data: { turbo_confirm: t('data_fix.wizard.confirm.add_swimmer') }) do
        = hidden_field_tag :file_path, @file_path
        - %i[swimmers_page swimmers_per_page q filter_state].each do |key|
          = hidden_field_tag(key, params[key]) if params[key].present?
        %button.btn.btn-sm.btn-success{ type: 'submit' }
          %i.fa.fa-plus{ 'aria-hidden': 'true' }
          = t('data_fix.wizard.buttons.add_swimmer')

  -# Swimmers as collapsible cards (each one in its key-based Turbo frame: saved in place)
  - if @items.empty?
    .alert.alert-info
      %em= t('data_fix.wizard.swimmers.none')
  - else
    - @items.each_with_index do |swimmer_hash, idx|
      = render(partial: 'data_fix/swimmer_card_frame',
               locals: { swimmer_hash:, swimmer_index: ((@page - 1) * @per_page) + idx,
                         swimmer_team_key: @team_key_by_swimmer_key[swimmer_hash['key']],
                         file_path: @file_path, api_url: @api_url })

  -# Pagination controls (bottom)
  .mt-3.mb-4
    - if @items.present?
      = render(PageLinksForArrayComponent.new(data: @items, total_count: @total_count, page: @page, per_page: @per_page,
                                              param_name: :swimmers_page, extra_params: page_params))
