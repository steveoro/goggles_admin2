-# frozen_string_literal: true

= render(partial: 'goggles/modal_progress')

- page_params = { filter_state: @filter_state, q: @q, teams_per_page: @per_page, file_path: @file_path, phase2_v2: 1 }
.container-fluid
  = render(Shell::PageHeaderComponent.new(title: t('data_fix.wizard.title', number: 2, name: t('data_fix.steps.teams')),
                                          subtitle: File.basename(@file_path).split('.json').first)) do |header|
    - header.with_actions do
      = link_to(pull_result_files_path, class: 'btn btn-sm btn-outline-secondary') do
        %i.fa-solid.fa-arrow-left{ 'aria-hidden': 'true' }
        = t('data_fix.wizard.back_to_files')
      = link_to(review_swimmers_path(request.query_parameters.merge(phase3_v2: 1)), class: 'btn btn-sm btn-primary') do
        = t('data_fix.wizard.proceed', number: 3, name: t('data_fix.steps.swimmers'))
        %i.fa-solid.fa-arrow-right{ 'aria-hidden': 'true' }

  = render(data_fix_stepper(2))
  = render(DataFix::IssueNavComponent.new(nav: @issue_nav))

  = render(partial: 'data_fix/phase_metadata', locals: { phase_number: 2, metadata: @phase2_meta,
                                                         extra_info: File.basename(@file_path).split('.json').first })
  - team_scores = Array(@phase2_data['team_scores'])
  - if team_scores.any?
    = render(partial: 'data_fix/team_scores_card', locals: { team_scores:, teams: @phase2_data['teams'] })

  -# Search and filter controls
  .card.my-2
    .card-header
      = render(DataFix::TurboFilterStateComponent.new(target_url: review_teams_path,
                                                      hidden_params: { file_path: @file_path, phase2_v2: 1 },
                                                      per_page_param_name: :teams_per_page, per_page_value: @per_page,
                                                      filter_state: @filter_state, q: @q,
                                                      q_min_length: DataFix::BaseController::TURBO_FILTER_MIN_QUERY_LENGTH,
                                                      q_placeholder: t('data_fix.wizard.teams.search_placeholder'),
                                                      review_help_text: t('data_fix.wizard.teams.review_help')))
    .card-body.py-2.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
      %span.small= t('data_fix.wizard.page_info', page: @page, pages: @total_pages, range: @row_range, count: @total_count)
      - if @items.present?
        .flex-grow-1
          = render(PageLinksForArrayComponent.new(data: @items, total_count: @total_count, page: @page,
                                                  per_page: @per_page, param_name: :teams_page, extra_params: page_params))
      = form_tag(data_fix_add_team_path, method: :post, class: 'd-inline', data: { turbo_confirm: t('data_fix.wizard.confirm.add_team') }) do
        = hidden_field_tag :file_path, @file_path
        - %i[teams_page teams_per_page q filter_state].each do |key|
          = hidden_field_tag(key, params[key]) if params[key].present?
        %button.btn.btn-sm.btn-success{ type: 'submit' }
          %i.fa.fa-plus{ 'aria-hidden': 'true' }
          = t('data_fix.wizard.buttons.add_team')

  -# Collapsible card layout for each team (each one in its key-based Turbo frame: saved in place)
  - if @items.empty?
    .alert.alert-info
      %em= t('data_fix.wizard.teams.none')
  - else
    - @items.each_with_index do |team_hash, idx|
      = render(partial: 'data_fix/team_card_frame',
               locals: { team_hash:, team_index: ((@page - 1) * @per_page) + idx, file_path: @file_path, api_url: @api_url })

  -# Pagination controls (bottom)
  .mt-3.mb-4
    - if @items.present?
      = render(PageLinksForArrayComponent.new(data: @items, total_count: @total_count, page: @page,
                                              per_page: @per_page, param_name: :teams_page, extra_params: page_params))
