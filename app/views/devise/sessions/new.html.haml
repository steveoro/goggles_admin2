.container.py-4
  .row.justify-content-center
    .col-12.col-md-8.col-lg-5
      #login-box.mt-4
        %h2.mb-3= t('.sign_in')
        = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
          .card.card-body.bg-body-tertiary.shadow-sm
            .mb-3.field
              = f.label(:email, t('activerecord.attributes.goggles_db/user.email'), class: 'form-label')
              = f.email_field(:email, autofocus: true, autocomplete: 'email',
                              class: 'form-control', 'aria-describedby' => 'email-help',
                              placeholder: t('users.placeholders.email'))
              %small.form-text.text-body-secondary#email-help
                %i= t('devise.customizations.we_wont_share_emails_with_noone')
            .mb-3.field
              = f.label(:password, t('activerecord.attributes.user.password'), class: 'form-label')
              = f.password_field(:password, autocomplete: 'current-password',
                                 class: 'form-control', placeholder: t('users.placeholders.password'))
            - if devise_mapping.rememberable?
              .mb-3.form-check.field
                = f.check_box(:remember_me, class: 'form-check-input')
                = f.label(:remember_me, t('activerecord.attributes.user.remember_me'), class: 'form-check-label')
            .actions
              = f.submit(t('.sign_in'), id: 'login-btn', class: 'btn btn-primary')
      = render('devise/shared/links')
