-# Builds the export/base-timings URL builders for the shared engine ranking partial and delegates to it.
:ruby
  ranking_locals = local_assigns.merge(
    export_path: goggle_cup_export_lambda(local_assigns),
    base_timings_path: goggle_cup_base_timings_path(local_assigns)
  )
= render partial: 'goggles_db/goggle_cups/ranking', locals: ranking_locals
