%section.my-2#select-swimmers
  .card
    .card-header.d-flex.justify-content-between.align-items-center{ id: 'swimmer-list-header' }
      %h5.mb-0= t('goggles_cup.swimmers_for_team', team: team.name)
      .d-flex.align-items-center
        - if readonly && goggle_cup
          = link_to(clear_ranking_goggles_cup_preview_path(goggle_cup_id: goggle_cup.id),
                    class: 'btn btn-sm btn-outline-warning mx-2', id: 'btn-edit-swimmers',
                    data: { turbo_method: :post, turbo_confirm: t('goggles_cup.confirm_clear_ranking'),
                            toggle: 'tooltip', placement: 'left', title: t('goggles_cup.edit_selection_tooltip') }) do
            %i.fa.fa-pencil
            = t('goggles_cup.edit_selection')
        %button.btn.btn-sm.btn-outline-primary{ type: 'button', data: { toggle: 'collapse', target: '#swimmer-list-body' }, 'aria-expanded' => 'true', 'aria-controls' => 'swimmer-list-body' }
          %i.fa.fa-list
          = t('goggles_cup.select_swimmers')
    #swimmer-list-body.collapse.show{ 'aria-labelledby' => 'swimmer-list-header', data: { 'goggles-cup-target': 'swimmerPanel' } }
      .card-body
        - if readonly
          .alert.alert-info.small.py-2.mb-3#swimmer-list-readonly-hint
            %i.fa.fa-info-circle.me-1
            = t('goggles_cup.readonly_hint')
        - else
          .row.mb-3
            .col-md-6
              = render(ComboBox::AutocompleteTeamComponent.new(default_row: secondary_team, label: t('goggles_cup.secondary_team'),
                                                             required: false, base_name: 'secondary_team', jwt: jwt))
            .col-md-6.d-flex.align-items-end
              %small.text-muted= t('goggles_cup.secondary_team_explanation')
          .row.mb-3
            .col-12
              %button.btn.btn-sm.btn-outline-secondary{ type: 'button', data: { action: 'goggles-cup#selectAll' } }
                = t('goggles_cup.select_all')
              %button.btn.btn-sm.btn-outline-secondary{ type: 'button', data: { action: 'goggles-cup#deselectAll' } }
                = t('goggles_cup.deselect_all')

        .row.mb-2
          .col-12.text-end
            %span.text-muted.font-weight-bold{ data: { 'goggles-cup-target': 'selectionCounter' } }
              (0 / 0)

        .row
          .col-12
            .table-responsive
              %table.table.table-striped.table-hover.table-sm
                %thead
                  %tr
                    %th{ width: '50' }= t('goggles_cup.select')
                    %th= t('goggles_cup.swimmer_name')
                    %th= t('goggles_cup.year_of_birth')
                %tbody
                  - swimmers.each do |swimmer|
                    - swimmer_id = swimmer[:swimmer_id]
                    %tr
                      %td.text-center
                        %label.switch.round
                          = check_box_tag('swimmer_ids[]', swimmer_id, selected_swimmer_ids.map(&:to_s).include?(swimmer_id.to_s),
                                          id: "swimmer_#{swimmer_id}", disabled: readonly,
                                          data: { 'goggles-cup-target': 'swimmerCheckbox', swimmer_id: swimmer_id, action: 'change->goggles-cup#updateSelectionCounter' })
                          %span.slider.round
                      %td= swimmer[:swimmer_name]
                      %td= swimmer[:swimmer_year_of_birth]

        -# External swimmers (not belonging to the primary team but included in the cup config)
        - if external_swimmers.present?
          .row.mt-4
            .col-12
              %h6.text-muted= t('goggles_cup.external_swimmers')
              .table-responsive{ data: { 'goggles-cup-target': 'externalSwimmersContainer' } }
                %table.table.table-sm.table-bordered
                  %thead
                    %tr
                      %th{ width: '50' }= t('goggles_cup.select')
                      %th= t('goggles_cup.swimmer_name')
                      %th= t('goggles_cup.year_of_birth')
                  %tbody
                    - external_swimmers.each do |swimmer|
                      - swimmer_id = swimmer[:swimmer_id]
                      %tr
                        %td.text-center
                          %label.switch.round
                            = check_box_tag('swimmer_ids[]', swimmer_id, selected_swimmer_ids.map(&:to_s).include?(swimmer_id.to_s),
                                            id: "external_swimmer_#{swimmer_id}", disabled: readonly,
                                            data: { 'goggles-cup-target': 'swimmerCheckbox', swimmer_id: swimmer_id, action: 'change->goggles-cup#updateSelectionCounter' })
                            %span.slider.round
                        %td= swimmer[:swimmer_name]
                        %td= swimmer[:swimmer_year_of_birth]

        .row.mt-3
          .col-12.text-end
            %button.btn.btn-sm.btn-outline-secondary#btn-go-to-top{ type: 'button',
                    data: { action: 'click->goggles-cup#goToTop' } }
              %i.fa.fa-arrow-up.me-1
              = t('goggles_cup.go_to_top')
