-#
  After a "Flag cancelled" apply (Health::CancellationsController#create redirects here with cancelled=<script name>):
  the script to push, with the link to the Outbox focused on it.
  Locals: season_id.
- script = params[:cancelled].to_s
- if script.match?(SeasonBoard::DiskIndex::BOARD_SQL_REGEXP)
  .alert.alert-success.d-flex.flex-wrap.align-items-center.gap-2#health-cancelled-notice{ role: 'status' }
    %i.fa-solid.fa-circle-check{ 'aria-hidden' => 'true' }
    %span= t('health.cancellations.done', file: script)
    = link_to(t('health.cancellations.open_push'), outbox_path(focus: script), class: 'alert-link')
