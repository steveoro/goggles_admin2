-#
  "Flag cancelled" dry-run preview (Health::CancellationsController#new): nothing is written until "Apply".
:ruby
  preview = @preview
  season = @canceller.season
  crumbs = [[t('shell.groups.data_quality'), nil], [t('health.title'), health_path]]
  crumbs << [t('health.season.crumb', id: season.id), health_season_path(season.id)] if season
  crumbs << [t('health.cancellations.crumb'), nil]
  counts = preview.counts
  form_options = { url: health_cancellations_path, method: :post, id: 'health-cancellation-form',
                   data: { turbo_confirm: t('health.cancellations.confirm') } }
= render(Shell::PageHeaderComponent.new(title: t("health.cancellations.title.#{@canceller.kind}"), crumbs:,
                                        subtitle: t('health.cancellations.subtitle')))

.row.g-3#health-cancellation{ data: { kind: @canceller.kind } }
  .col-12.col-xl-7
    %section.card
      .card-header.d-flex.align-items-center.gap-2
        %i.fa-solid.fa-ban{ 'aria-hidden' => 'true' }
        %h2.h6.mb-0= t('health.cancellations.preview')
      .card-body
        - if preview.error
          .alert.alert-danger#health-cancellation-error{ role: 'alert' }= preview.error
        %dl.row.small.mb-3
          - if preview.meeting
            %dt.col-sm-4.text-body-secondary= t('health.cancellations.meeting')
            %dd.col-sm-8.mb-1
              #{preview.meeting.id} · #{preview.meeting.header_date} · #{preview.meeting.description}
              - if preview.meeting.cancelled
                %span.badge.text-bg-secondary= t('health.cancellations.already_cancelled')
          - if preview.calendar
            %dt.col-sm-4.text-body-secondary= t('health.cancellations.calendar')
            %dd.col-sm-8.mb-1
              #{preview.calendar.id} · #{preview.calendar.scheduled_date} · #{preview.calendar.meeting_name}
              - if preview.calendar.cancelled
                %span.badge.text-bg-secondary= t('health.cancellations.already_cancelled')
          - if preview.counts.present?
            %dt.col-sm-4.text-body-secondary= t('health.cancellations.counts')
            %dd.col-sm-8.mb-1#health-cancellation-counts
              = t('health.cancellations.counts_text', events: counts[:events], mirs: counts[:mirs], mrrs: counts[:mrrs])
        - if preview.sql.present?
          %label.form-label.small.mb-1{ for: 'health-cancellation-sql' }= t('health.cancellations.sql')
          %pre.small.bg-body-tertiary.border.rounded.p-2#health-cancellation-sql{ tabindex: '0' }= preview.sql
        - if preview.ok?
          %p.small.text-body-secondary= t('health.cancellations.apply_hint')
          = form_with(**form_options) do
            = hidden_field_tag(:digest, preview.digest, id: nil)
            - if @finding
              = hidden_field_tag(:finding_id, @finding.id, id: nil)
            - else
              = hidden_field_tag(:season_id, season&.id, id: nil)
              = hidden_field_tag(:meeting_id, @canceller.meeting_id, id: nil)
              = hidden_field_tag(:calendar_id, @canceller.calendar_id, id: nil)
            .d-flex.flex-wrap.gap-2
              = button_tag(type: 'submit', class: 'btn btn-danger', id: 'btn-health-apply-cancel') do
                %i.fa-solid.fa-ban{ 'aria-hidden' => 'true' }
                = t('health.cancellations.apply')
              = link_to(t('health.cancellations.back'), health_finding_path(@finding), class: 'btn btn-outline-secondary') if @finding
  .col-12.col-xl-5
    %section.card
      .card-header.d-flex.align-items-center.gap-2
        %i.fa-solid.fa-circle-question{ 'aria-hidden' => 'true' }
        %h2.h6.mb-0= t('health.cancellations.alternatives')
      .card-body.small
        %p.mb-2= t('health.cancellations.ignore_first')
        - if @finding && !@finding.resolved?
          = link_to(t('health.cancellations.ignore_instead'), health_finding_path(@finding, anchor: 'health-finding-actions'),
                    class: 'btn btn-sm btn-outline-secondary')
