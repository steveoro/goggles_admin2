!!!
%html{ lang: I18n.locale, data: { bs_theme: current_theme } }
  %head
    %meta{ content: 'text/html; charset=UTF-8', 'http-equiv' => 'Content-Type' }/
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1, shrink-to-fit=no' }/
    %meta{ name: 'description', content: 'Master-Goggles administration' }/
    %meta{ name: 'author', content: 'FASAR Software, Steve Alloro, 2012-2021' }/
    %meta{ name: 'keywords', content: 'Master swimming results' }/
    %title Goggles
    = csrf_meta_tags
    = csp_meta_tag
    -#
      Vendored assets (vendor/assets/stylesheets), so the app works offline. Font Awesome must be
      linked, not @use'd into application.scss: Propshaft resolves its ../webfonts URLs.
    = stylesheet_link_tag('bootstrap/bootstrap.min', media: 'all', 'data-turbo-track': 'reload')
    = stylesheet_link_tag('fontawesome/css/all.min', media: 'all', 'data-turbo-track': 'reload')
    = stylesheet_link_tag('fontawesome/css/v4-shims.min', media: 'all', 'data-turbo-track': 'reload')
    = stylesheet_link_tag('tom-select/tom-select.bootstrap5.min', media: 'all', 'data-turbo-track': 'reload')
    = stylesheet_link_tag('application', media: 'all', 'data-turbo-track': 'reload')
    = javascript_importmap_tags

  %body{ data: { controller: 'tooltips' } }
    %section#header
      = render('goggles/main_navbar')

    %section#notify
      .wrapper-body
        .spacer-left
        .main-content
          #flash-messages-container
            = render(partial: 'goggles/flash_messages')
            -# Local session without a valid API JWT (API server unreachable at sign-in; Settings has its own box):
            - if user_signed_in? && api_offline_session? && controller_name != 'settings'
              = render(partial: 'goggles/api_offline_banner')
            -# Local ops DB not configured, missing or not migrated (see Ops::Database):
            - if user_signed_in? && (ops_state = Ops.state) != :ready
              = render(partial: 'goggles/ops_setup_notice', locals: { state: ops_state })
            -# Pending FIN "Riepilogo Eventi" change alert (live updates via AppNotificationsChannel):
            = render(FedernuotoWatchAlertComponent.from_store) if user_signed_in?
        .spacer-right

    %section#content
      = yield
