.container.bg-light-green.pt-2.shadow-box#crawler-status-box
  .row-fluid.text-center
    %h5
      🕷 Crawler Server
  .row
    .col-12
      %em
        localhost:7000
      %i.fa.fa-spin.fa-question-circle-o#crawler-status-icon
      &nbsp;
      %b
        %small.text-secondary#crawler-status= t('data_import.errors.crawler_connecting')
  .row
    .col-12.pb-2
      %small#crawler-detail
        = t('data_import.errors.crawler_connecting')
  .row-fluid.pb-2.d-none#crawler-progress-row
    .progress
      .progress-bar#crawler-progress{ role: 'progressbar', 'aria-valuenow': '0',
                                      'aria-valuemin': '0', 'aria-valuemax': '100',
                                      style: 'width: 0%' } 20%
  .row.pb-2
    .col-12
      = button_to(start_crawler_path,
                  method: :post, class: 'btn btn-sm btn-outline-success', form_class: 'd-inline',
                  id: 'btn-start-crawler', title: t('federnuoto_watch.crawler.start_tooltip')) do
        %i.fa.fa-play{ 'aria-hidden' => 'true' }
        = t('federnuoto_watch.crawler.start')
  .row.pb-2.border-top.pt-2#season-board-activity-row
    .col-12
      = render(SeasonBoard::ActivityStripComponent.new)
  - watch_state = FedernuotoWatch::StateStore.new.read
  .row.pb-2.border-top.pt-2#federnuoto-watch-status
    .col-12
      %small
        %b= t('federnuoto_watch.title')
        %br
        - if (last_checked = FedernuotoWatch.local_time(watch_state['last_checked']))
          = t('federnuoto_watch.status.last_checked', time: l(last_checked, format: :short))
        - else
          = t('federnuoto_watch.status.never_checked')
        - if watch_state['last_error'].present?
          %br
          %span.text-danger= watch_state['last_error'].truncate(160)
      = button_to(federnuoto_watch_check_path,
                  method: :post, class: 'btn btn-sm btn-outline-secondary mt-1', form_class: 'd-inline',
                  id: 'btn-federnuoto-watch-check') do
        %i.fa.fa-refresh{ 'aria-hidden' => 'true' }
        = t('federnuoto_watch.check.now')
