-#
  Rows frame of the Season board ('season-board-rows'): rendered by the board page and, alone (no layout),
  by its live refresh (season_board_path(frame: 1), see season_board_controller.js). Locals: board
  (SeasonBoard::Builder::Result), rows (visible rows), state_counts, unlinked_count, done_count,
  state_filter, show_unlinked, show_done (see SeasonBoardController#rows_frame_locals).
  The content is season_board/_rows_frame_content (also sent alone by the turbo stream of a row action).
= turbo_frame_tag('season-board-rows', target: '_top', data: { 'season-board-target': 'frame' }) do
  = render(partial: 'season_board/rows_frame_content',
           locals: { board:, rows:, state_counts:, unlinked_count:, done_count:, state_filter:, show_unlinked:, show_done: })
