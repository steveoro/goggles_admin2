-#
  Content of the rows frame (season_board/_rows_frame, same locals), also sent alone by the turbo stream of a row action
  (SeasonBoardController#render_rows_stream). Chip and toggle links carry filters=1: an explicit choice (SeasonBoard::Filters).
- toggles = { show_unlinked: (1 if show_unlinked), show_done: (1 if show_done) }.compact.merge(filters: 1)
%span.d-none{ data: { 'season-board-busy': board.active_activities.any?.to_s } }
= render(SeasonBoard::ActivityStripComponent.new(activities: board.active_activities,
                                                 names: board.rows.to_h { |r| [r.fin_event_id.to_s, r.name] }))

- if board.warnings.any? && board.rows.any?
  .alert.alert-warning.py-2.mb-2#season-board-warnings
    %b= t('season_board.header.warnings')
    %ul.mb-0.small
      - board.warnings.each do |warning|
        %li= warning

- if board.rows.empty?
  .alert.alert-info#season-board-empty
    = t('season_board.empty.no_rows')
    = button_to(federnuoto_watch_check_path, method: :post, class: 'btn btn-sm btn-primary ms-2',
                form_class: 'd-inline') do
      %i.fa-solid.fa-rotate{ 'aria-hidden' => 'true' }
      = t('season_board.empty.check_now')
- else
  .mb-2#season-board-filters
    -# (theme-aware chips: the selected one is primary)
    - chip_css = 'bg-body-tertiary text-body-emphasis border'
    -# ("All" clears the state chip, also in the cookie; the toggles below keep their own links)
    = link_to(t('season_board.filters.all', count: board.rows.size), season_board_path(toggles),
              class: "badge rounded-pill me-1 #{state_filter ? chip_css : 'text-bg-primary'}",
              id: 'season-board-chip-all', title: t('season_board.filters.all_tooltip'),
              data: { state_chip: 'all', chip_selected: state_filter.nil?.to_s })
    -# (the selected chip is always shown, also when no row is left in its state: it can be seen and cleared)
    - chip_counts = state_filter.nil? || state_counts.keys.map(&:to_s).include?(state_filter) ? state_counts : state_counts.merge(state_filter.to_sym => 0)
    - chip_counts.each do |state, count|
      = link_to("#{state == :in_review ? t('season_board.states.in_review_chip') : t("season_board.states.#{state}")} (#{count})",
                season_board_path(toggles.merge(state: state)),
                class: "badge rounded-pill me-1 #{state_filter == state.to_s ? 'text-bg-primary' : chip_css}",
                title: t("season_board.state_tooltips.#{state}"),
                data: { state_chip: state, chip_selected: (state_filter == state.to_s).to_s })
    %br
    %small
      - if unlinked_count.positive? || show_unlinked
        - if show_unlinked
          = link_to(t('season_board.filters.hide_unlinked'), season_board_path(toggles.except(:show_unlinked)), class: 'me-3')
        - else
          = link_to(t('season_board.filters.show_unlinked', count: unlinked_count),
                    season_board_path(toggles.merge(show_unlinked: 1)), class: 'me-3')
      - if done_count.positive? || show_done
        - if show_done
          = link_to(t('season_board.filters.hide_done'), season_board_path(toggles.except(:show_done)))
        - else
          = link_to(t('season_board.filters.show_done', count: done_count),
                    season_board_path(toggles.merge(show_done: 1)))

  .table-responsive
    %table.table.table-sm.table-hover.mb-3#season-board-table
      %thead.table-body-tertiary
        %tr
          %th= t('season_board.columns.date')
          %th= t('season_board.columns.name')
          %th= t('season_board.columns.place')
          %th= t('season_board.columns.local')
          %th= t('season_board.columns.state')
          %th= t('season_board.columns.activity')
          %th= t('season_board.columns.action')
      %tbody
        - rows.each do |row|
          = render(SeasonBoard::RowComponent.new(row:, orphans: board.link_candidates, csrf_token: form_authenticity_token))
        - if rows.empty?
          %tr
            %td.text-center.text-body-secondary{ colspan: 7 }= t('season_board.filters.none_visible')

.mb-2#season-board-orphans
  %a{ href: '#orphans-collapse', data: { bs_toggle: 'collapse' }, 'aria-expanded' => 'false',
      'aria-controls' => 'orphans-collapse' }
    %i.fa-solid.fa-caret-right{ 'aria-hidden' => 'true' }
    = t('season_board.orphans.title', count: board.orphans.size)
  #orphans-collapse.collapse.mt-2
    - if board.orphans.empty?
      %small.text-body-secondary= t('season_board.orphans.empty')
    - else
      %table.table.table-sm.mb-0
        %thead
          %tr
            %th= t('season_board.columns.id')
            %th= t('season_board.columns.code')
            %th= t('season_board.columns.name')
            %th= t('season_board.columns.date')
            %th= t('season_board.columns.meeting_id')
            %th= t('season_board.columns.fin_event_id')
        %tbody
          - board.orphans.each do |orphan|
            %tr{ data: { orphan_id: orphan.id } }
              %td= orphan.id
              %td= orphan.meeting_code
              %td= orphan.meeting_name
              %td= orphan.scheduled_date
              %td= orphan.meeting_id
              %td
                - if orphan.fin_event_id
                  = orphan.fin_event_id
                  %span.badge.text-bg-warning{ title: t('season_board.orphans.not_on_calendar_tooltip') }
                    = t('season_board.orphans.not_on_calendar')

- if board.unmatched_sources.any?
  %p.small.text-body-secondary.mb-0#season-board-unmatched
    = t('season_board.unmatched.text', count: board.unmatched_sources.size)
    = link_to(t('season_board.unmatched.link'), sources_results_path, data: { turbo_frame: '_top' })
