-#
  DB sync warning before a Season board calendar link (SeasonBoardController#link, Drift::Gate scope :board_write):
  the verdict and its reasons, then the same link posted again with the operator's tick (drift_ack=1).
  0.10.102: for a row whose link is adopted from the FIN 'Eventi' calendar, also (or only, with a green DB sync) the
  note saying where the FIN id and the link come from, with its own tick (adopted_ack=1).
  Locals (ivars): @gate, @row, @calendar_id.
:ruby
  adopted = @row.flag?(:link_adopted)
  gate_warning = !@gate.allowed?
  link = @row.respond_to?(:adopted_link) ? @row.adopted_link : nil
= render(Shell::PageHeaderComponent.new(title: gate_warning ? t('db_sync.gate.board_title') : t('season_board.link_adopted_confirm.title'),
                                        subtitle: "#{@row.name} (FIN #{@row.fin_event_id})"))
.card.mb-3#season-board-confirm-link
  .card-body
    - if adopted
      .alert.alert-warning#season-board-confirm-adopted
        = t('season_board.link_adopted_confirm.text', fin_event_id: @row.fin_event_id, file: link&.file_name || '?',
                                                      date: link&.calendar_date&.strftime('%d/%m/%Y') || '?')
    - if gate_warning
      %p= t('db_sync.gate.board_intro')
      = render(Drift::IndicatorComponent.new(fingerprint: @gate.verdict, details: true))
    = form_with(url: season_board_link_path, method: :post, class: 'mt-3', id: 'frm-season-board-confirm-link', data: { turbo: false }) do
      = hidden_field_tag(:fin_event_id, @row.fin_event_id, id: nil)
      = hidden_field_tag(:calendar_id, @calendar_id, id: nil)
      - if adopted
        .form-check.mb-3
          = check_box_tag(:adopted_ack, '1', false, class: 'form-check-input', required: true)
          = label_tag(:adopted_ack, t('season_board.link_adopted_confirm.ack'), class: 'form-check-label')
      - if gate_warning
        .form-check.mb-3
          = check_box_tag(:drift_ack, '1', false, class: 'form-check-input', required: true)
          = label_tag(:drift_ack, t('db_sync.gate.board_ack'), class: 'form-check-label')
      .d-flex.flex-wrap.gap-2
        = button_tag(t('db_sync.gate.board_submit'), type: 'submit', class: 'btn btn-warning', id: 'btn-season-board-confirm-link')
        = link_to(t('db_sync.gate.cancel'), season_board_path, class: 'btn btn-outline-secondary')
