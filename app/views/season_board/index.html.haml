- checked_at = @board.snapshot_checked_at
= render(Shell::PageHeaderComponent.new(title: t('season_board.title'), count: nil,
                                        subtitle: t('season_board.header.season', description: @season.description))) do |header|
  - header.with_actions do
    = button_to(federnuoto_watch_check_path, method: :post, class: 'btn btn-sm btn-outline-secondary',
                form_class: 'd-inline', id: 'btn-season-board-check') do
      %i.fa-solid.fa-rotate{ 'aria-hidden' => 'true' }
      = t('federnuoto_watch.check.now')

%section#season-board
  %p.small.text-body-secondary.mb-2
    - if checked_at
      = t('season_board.header.last_checked', time: l(checked_at.in_time_zone, format: :short))
    - else
      = t('season_board.header.never_checked')
    - if @board.pending_board_sql_paths.any?
      %br
      %span#season-board-sql-pending{ title: t('season_board.header.board_sql_pending_tooltip') }
        %span.badge.text-bg-danger= t('season_board.header.board_sql_pending', count: @board.pending_board_sql_paths.size)
        = link_to(t('season_board.header.board_sql_pending_link'), push_index_path)

  %div{ data: { controller: 'season-board', 'season-board-interval-value': 20_000,
                'season-board-ping-id-value': 'season-board-ping' } }
    = render(partial: 'season_board/rows_frame', locals: rows_frame_locals)
